/* ---------------------------------------------------------------------- */
/*  DepositsLoansDashboard.jsx — root component                            */
/*  Purely presentational/compositional. Every number on screen comes      */
/*  from the `data` prop, every drill-down from `fetchDrilldown`. Nothing  */
/*  is imported or hardcoded here — see DashboardPage.jsx for how the real */
/*  API's response gets mapped into this shape (mapApiToDashboardData.js). */
/*                                                                          */
/*  LAYOUT — genuine MASONRY (Pinterest-style), not a CSS Grid with        */
/*  row/column spans. A row/column-span grid (the previous version) still  */
/*  forces items into rows whenever spans happen to divide evenly, which   */
/*  is exactly what looked wrong. This uses CSS multi-column layout        */
/*  instead: `columnCount` splits the container into N vertical columns,   */
/*  and the browser fills each panel into whichever column currently has   */
/*  the least content — DOM order flows top-to-bottom down column 1, then  */
/*  column 2, etc. There's no concept of "rows" at all, so panels of       */
/*  different natural heights interlock organically instead of being      */
/*  forced to align.                                                      */
/*                                                                          */
/*  Every panel is wrapped in a small Box with `breakInside: "avoid"`      */
/*  (a panel is never split across two columns) and `mb` for the vertical  */
/*  gap (CSS multi-column doesn't support row-gap the way flex/grid do —   */
/*  margin-bottom is the standard way to space items within a column).     */
/* ---------------------------------------------------------------------- */

import React, { useState } from "react";
import { Box, Stack, Typography } from "@mui/material";
import AccountBalanceRoundedIcon from "@mui/icons-material/AccountBalanceRounded";
import AccountBalanceWalletRoundedIcon from "@mui/icons-material/AccountBalanceWalletRounded";
import DescriptionRoundedIcon from "@mui/icons-material/DescriptionRounded";
import TrendingUpRoundedIcon from "@mui/icons-material/TrendingUpRounded";
import { textPrimarySx, textSecondarySx } from "./common";
import HeatTree from "./HeatTree";
import Gauge from "./Gauge";
import BarPanel from "./BarPanel";

/** Page title/subtitle. Only used once, kept inline rather than as its
 * own file. */
function DashboardHeader({ config }) {
  return (
    <Stack
      direction={{ xs: "column", lg: "row" }}
      alignItems={{ xs: "flex-start", lg: "center" }}
      justifyContent="space-between"
      spacing={2}
      sx={{ px: 0.5 }}
    >
      <Box>
        <Typography sx={{ ...textPrimarySx, fontSize: { xs: 20, md: 24 }, fontWeight: 700 }}>
          {config.title}
        </Typography>
        {config.subtitle && (
          <Typography sx={{ ...textSecondarySx, fontSize: 13, mt: 0.25 }}>{config.subtitle}</Typography>
        )}
      </Box>
    </Stack>
  );
}

/** One masonry cell: never splits across columns, spaced from the next
 * cell below it in the same column via margin-bottom (multi-column layout
 * has no native row-gap). */
function MasonryItem({ children }) {
  return (
    <Box
      sx={{
        breakInside: "avoid",
        WebkitColumnBreakInside: "avoid", // Safari
        mb: 2.5,
      }}
    >
      {children}
    </Box>
  );
}

