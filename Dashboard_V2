/** First section matching any of the given keys — supports both new API
 * keys ("loans", "totalDeposits") and old ones ("loansBreakdown"). */
function trendSection(trendSections, ...keys) {
  for (const key of keys) {
    const found = trendSections?.find((s) => s.key === key);
    if (found) return found;
  }
  return undefined;
}

