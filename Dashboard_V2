          icon={DescriptionRoundedIcon}
          section={trendSection(trendSections, "timeDeposits")}
          panelId="term-deposits-bar"
          selectedPanel={selectedPanel}
          onSelectPanel={setSelectedPanel}
        />
      </Box>

      <TotalDepositsTrendPanel
        icon={ShowChartRoundedIcon}
        totalTrendSection={trendSection(trendSections, "totalDeposits", "totaldeposittrend")}
        demandSection={trendSection(trendSections, "demandDeposits")}
        timeSection={trendSection(trendSections, "timeDeposits")}
        panelId="total-deposits-trend"
        selectedPanel={selectedPanel}
        onSelectPanel={setSelectedPanel}
      />
    </Box>
  );
}


















