/* ---------------------------------------------------------------------- */
/*  DateWiseBarPanel.jsx                                                   */
/*  A multi-date panel — replaces the single-snapshot BarPanel for         */
/*  Demand Deposits, Time Deposits, and Loan Distribution. Two things      */
/*  live in this one panel:                                                */
/*                                                                          */
/*  1. OVERVIEW — every date in `section.data`, one grouped cluster of     */
/*     bars per date (one bar per category/product), matching the          */
/*     reference "Chart Title" screenshot's clustered-bar style.          */
/*  2. DRILL-DOWN — click ANY bar (or line point) in the overview and it   */
/*     narrows to that ONE date's breakdown, all categories, with a Back   */
/*     button to return to the overview. Which specific colored bar was    */
/*     clicked doesn't matter — every bar in a cluster shares the same     */
/*     date, so a click always drills into that date.                     */
/*                                                                          */
/*  Independently of that, the icon button in the top-right corner (same   */
/*  spot as BarPanel's toggle) switches whichever of the two views above   */
/*  is currently showing between a BAR chart and a LINE chart — 4 total    */
/*  render states (overview-bar, overview-line, drilldown-bar,             */
/*  drilldown-line), same underlying data throughout.                     */
/*                                                                          */
/*  DATA SHAPE — this consumes the "columnar" mock shape directly:         */
/*    { title, products: [{name, type}], data: [{date, values}] }         */
/*  where `values[i]` corresponds to `products[i]`. This is currently      */
/*  wired to the local bankingData.json mock (see DepositsLoansDashboard   */
/*  .jsx) rather than the live API — swap that one import for a real       */
/*  fetch when a multi-date endpoint exists; nothing in this file needs    */
/*  to change since it only cares about the shape above.                  */
/* ---------------------------------------------------------------------- */

import React, { useMemo, useState } from "react";
import { Box, IconButton, Stack, Tooltip, Typography } from "@mui/material";
import { alpha, useTheme } from "@mui/material/styles";
import {
  Bar,
  BarChart as RechartsBarChart,
  CartesianGrid,
  Cell,
  Line,
  LineChart as RechartsLineChart,
  ResponsiveContainer,
  Tooltip as RechartsTooltip,
  XAxis,
  YAxis,
} from "recharts";
import ShowChartRoundedIcon from "@mui/icons-material/ShowChartRounded";
import BarChartRoundedIcon from "@mui/icons-material/BarChartRounded";
import { glass } from "../../theme/themePrimitives"; // adjust path to match your project structure
import { GlassPanel, PanelHeader, BackButton, RADIUS, textSecondarySx } from "./common";
import { getColor, formatAmount } from "./utils";

/** "2026-09-17" -> "17-Sep", matching the reference screenshot's axis
 * label style. Falls back to the raw string if it doesn't parse (never
 * throws on unexpected date formats). */
function formatDateLabel(isoDate) {
  const d = new Date(isoDate);
  if (Number.isNaN(d.getTime())) return isoDate;
  return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short" }).replace(" ", "-");
}

/** Custom line-chart dot that's actually clickable — recharts' `dot={{onClick}}`
 * shorthand isn't a reliably documented event shape across versions; a
 * custom render function is the well-documented way to get direct access
 * to this point's own data row (including __isoDate) with no guessing. */
function ClickableDot({ cx, cy, payload, fill, radius, onDotClick }) {
  if (cx == null || cy == null) return null;
  return (
    <circle
      cx={cx}
      cy={cy}
      r={radius}
      fill={fill}
      stroke="none"
      style={{ cursor: "pointer" }}
      onClick={(e) => {
        e.stopPropagation();
        onDotClick(payload.__isoDate);
      }}
    />
  );
}

/** Small icon button, top-right, swapping the current view between bar
 * and line — independent of whether that view is the overview or a
 * drill-down. */
function ChartTypeToggle({ chartType, onToggle }) {
  const isLine = chartType === "line";
  return (
    <Tooltip title={isLine ? "Switch to bar chart" : "Switch to line chart"}>
      <IconButton
        size="small"
        onClick={(e) => {
          e.stopPropagation();
          onToggle();
        }}
      >
        {isLine ? <BarChartRoundedIcon fontSize="small" /> : <ShowChartRoundedIcon fontSize="small" />}
      </IconButton>
    </Tooltip>
  );
}

/** Custom tooltip for the overview (multi-date) chart — lists every
 * category's value for the hovered date. */
function OverviewTooltip({ active, payload, label, theme }) {
  if (!active || !payload || !payload.length) return null;
  return (
    <Box
      sx={{
        background: glass.panel(0.92),
        backdropFilter: "blur(16px) saturate(160%)",
        border: `1px solid ${glass.border}`,
        borderRadius: RADIUS.sm,
        px: 1.5,
        py: 1,
        boxShadow: theme.shadows[8],
        maxWidth: 220,
      }}
    >
      <Typography sx={{ fontSize: 11.5, fontWeight: 600, color: "text.secondary", mb: 0.5 }}>{label}</Typography>
      {payload.map((p) => (
        <Stack key={p.dataKey} direction="row" spacing={0.75} alignItems="center" sx={{ mb: 0.25 }}>
          <Box sx={{ width: 7, height: 7, borderRadius: "2px", bgcolor: p.color, flexShrink: 0 }} />
          <Typography sx={{ fontSize: 11.5, color: "text.primary" }} noWrap>
            {p.dataKey}: <b>{formatAmount(p.value)}</b>
          </Typography>
        </Stack>
      ))}
    </Box>
  );
}

/** Custom tooltip for the drill-down (single-date) chart — one category,
 * one value, same visual language as the rest of the dashboard's charts. */
function DrilldownTooltip({ active, payload, label, theme }) {
  if (!active || !payload || !payload.length) return null;
  return (
    <Box
      sx={{
        background: glass.panel(0.92),
        backdropFilter: "blur(16px) saturate(160%)",
        border: `1px solid ${glass.border}`,
        borderRadius: RADIUS.sm,
        px: 1.5,
        py: 1,
        boxShadow: theme.shadows[8],
      }}
    >
      <Typography sx={{ fontSize: 11.5, fontWeight: 600, color: "text.secondary" }}>{label}</Typography>
      <Typography sx={{ fontSize: 14, fontWeight: 800, color: payload[0].payload.__color }}>
        {formatAmount(payload[0].value)}
      </Typography>
    </Box>
  );
}

/**
 * Props:
 *  - section: { title, products: {name, type}[], data: {date, values: number[]}[] }
 *    (matches bankingData.json's per-section shape exactly)
 *  - icon: MUI icon component for the panel header
 *  - onDrilldownChange: optional (date: string | null) => void, fired
 *    whenever the drill-down state changes — lets a parent know without
 *    lifting the whole state up.
 *  - panelId / selectedPanel / onSelectPanel: optional click-to-highlight
 *    wiring, shared with every other panel (see GlassPanel in common.jsx).
 */
export default function DateWiseBarPanel({ section, icon, onDrilldownChange, panelId, selectedPanel, onSelectPanel }) {
  const theme = useTheme();
  const [chartType, setChartType] = useState("bar"); // "bar" | "line" — applies to whichever view is active
  const [selectedDate, setSelectedDate] = useState(null); // null = overview, else the drilled-into date

  const gridStrokeColor = alpha(theme.palette.text.primary, 0.08);

  // One consistent color per PRODUCT (category), by its fixed position in
  // the products list — never by date or render order, so a category's
  // color never shifts between the overview and a drill-down.
  const colorForProduct = useMemo(() => {
    const map = new Map(section.products.map((p, i) => [p.name, getColor(p.name, i, theme)]));
    return (name) => map.get(name) || getColor(name, 0, theme);
  }, [section.products, theme]);

  // Overview rows: one object per date, with each product's value keyed
  // by its own name — the shape Recharts' multi-series BarChart/LineChart
  // wants (one <Bar>/<Line> per key).
  const overviewRows = useMemo(
    () =>
      section.data.map((row) => {
        const entry = { date: formatDateLabel(row.date), __isoDate: row.date };
        section.products.forEach((p, i) => {
          entry[p.name] = row.values[i];
        });
        return entry;
      }),
    [section.data, section.products],
  );

  // Drill-down rows: the single selected date's products, reshaped into
  // the flat { name, value, __color } list the rest of the dashboard's
  // single-series charts already use.
  const drilldownRows = useMemo(() => {
    if (!selectedDate) return [];
    const row = section.data.find((d) => d.date === selectedDate);
    if (!row) return [];
    return section.products.map((p, i) => ({
      name: p.name,
      value: row.values[i],
      __color: colorForProduct(p.name),
    }));
  }, [selectedDate, section.data, section.products, colorForProduct]);

  const handleDrillInto = (isoDate) => {
    setSelectedDate(isoDate);
    onDrilldownChange?.(isoDate);
  };

  const handleBack = () => {
    setSelectedDate(null);
    onDrilldownChange?.(null);
  };

  const isDrilldown = Boolean(selectedDate);
  const drilldownLabel = isDrilldown ? formatDateLabel(selectedDate) : null;

  return (
    <GlassPanel sx={{ p: 3 }} selected={selectedPanel === panelId} onClick={() => onSelectPanel?.(panelId)}>
      <PanelHeader
        icon={icon}
        title={isDrilldown ? `${section.title} — ${drilldownLabel}` : section.title}
        action={
          <Stack direction="row" spacing={0.5} alignItems="center">
            {isDrilldown && <BackButton onBack={handleBack} />}
            <ChartTypeToggle chartType={chartType} onToggle={() => setChartType((v) => (v === "bar" ? "line" : "bar"))} />
          </Stack>
        }
      />
      {!isDrilldown && (
        <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>
          Click any bar to see that date's breakdown
        </Typography>
      )}

      <Box sx={{ width: "100%", height: 260, "& svg:focus, & svg *:focus": { outline: "none" } }}>
        <ResponsiveContainer>
          {isDrilldown ? (
            chartType === "line" ? (
              <RechartsLineChart data={drilldownRows} margin={{ top: 20, right: 16, left: -4, bottom: 6 }}>
                <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
                <XAxis dataKey="name" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={38} />
                <YAxis tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={32} />
                <RechartsTooltip content={(props) => <DrilldownTooltip {...props} theme={theme} />} />
                <Line dataKey="value" stroke={theme.palette.primary.main} strokeWidth={2} dot={{ r: 4 }} isAnimationActive={false} />
              </RechartsLineChart>
            ) : (
              <RechartsBarChart data={drilldownRows} margin={{ top: 20, right: 16, left: -4, bottom: 6 }} barCategoryGap="32%">
                <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
                <XAxis dataKey="name" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={38} />
                <YAxis tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={32} />
                <RechartsTooltip cursor={{ fill: alpha(theme.palette.text.primary, 0.05) }} content={(props) => <DrilldownTooltip {...props} theme={theme} />} />
                <Bar dataKey="value" radius={[6, 6, 0, 0]} maxBarSize={40}>
                  {drilldownRows.map((d) => (
                    <Cell key={d.name} fill={d.__color} />
                  ))}
                </Bar>
              </RechartsBarChart>
            )
          ) : chartType === "line" ? (
            <RechartsLineChart data={overviewRows} margin={{ top: 20, right: 16, left: -4, bottom: 6 }}>
              <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
              <XAxis dataKey="date" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={30} />
              <YAxis tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={32} />
              <RechartsTooltip content={(props) => <OverviewTooltip {...props} theme={theme} />} />
              {section.products.map((p) => (
                <Line
                  key={p.name}
                  dataKey={p.name}
                  stroke={colorForProduct(p.name)}
                  strokeWidth={2}
                  dot={(dotProps) => (
                    <ClickableDot key={dotProps.payload.__isoDate} {...dotProps} fill={colorForProduct(p.name)} radius={3} onDotClick={handleDrillInto} />
                  )}
                  activeDot={(dotProps) => (
                    <ClickableDot key={`active-${dotProps.payload.__isoDate}`} {...dotProps} fill={colorForProduct(p.name)} radius={5} onDotClick={handleDrillInto} />
                  )}
                  isAnimationActive={false}
                />
              ))}
            </RechartsLineChart>
          ) : (
            <RechartsBarChart data={overviewRows} margin={{ top: 20, right: 16, left: -4, bottom: 6 }} barCategoryGap="20%" barGap={2}>
              <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
              <XAxis dataKey="date" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={30} />
              <YAxis tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={32} />
              <RechartsTooltip cursor={{ fill: alpha(theme.palette.text.primary, 0.05) }} content={(props) => <OverviewTooltip {...props} theme={theme} />} />
              {section.products.map((p) => (
                <Bar
                  key={p.name}
                  dataKey={p.name}
                  fill={colorForProduct(p.name)}
                  radius={[3, 3, 0, 0]}
                  maxBarSize={18}
                  cursor="pointer"
                  onClick={(data) => handleDrillInto(data.__isoDate)}
                />
              ))}
            </RechartsBarChart>
          )}
        </ResponsiveContainer>
      </Box>

      <Box sx={{ mt: 1.5, display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(120px, 1fr))", rowGap: 0.75, columnGap: 1.5 }}>
        {section.products.map((p) => (
          <Stack key={p.name} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "2px", bgcolor: colorForProduct(p.name), flexShrink: 0 }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11, fontWeight: 500 }} noWrap>
              {p.name}
            </Typography>
          </Stack>
        ))}
      </Box>
    </GlassPanel>
  );
}


















/* ---------------------------------------------------------------------- */
/*  DepositsLoansDashboard.jsx — root component                            */
/*  Purely presentational/compositional. Every number on screen comes      */
/*  from the `data` prop. Demand/Time Deposits and Loan Distribution get   */
/*  their own multi-date drill-down via DateWiseBarPanel (see below).      */
/*                                                                          */
/*  LAYOUT — CSS Grid with hand-assigned COLUMN spans per panel (see       */
/*  GridItem below), not CSS multi-column masonry. Masonry always stacks   */
/*  items strictly top-to-bottom within whichever column has the least     */
/*  content — every item still belongs to exactly one column. This grid    */
/*  instead gives each panel an explicit WIDTH (2, 3, or 4 of 12 columns), */
/*  so the arrangement doesn't read as a uniform repeating pattern.        */
/*                                                                          */
/*  WHY NOT ROW SPANS TOO — a bento layout with one tall panel that two    */
/*  short ones tuck in beside (like a stock dashboard mockup) needs each   */
/*  panel's ROW span to match its actual rendered height in pixels. Get    */
/*  that even slightly wrong and CSS Grid does NOT reflow around it —     */
/*  content from two different panels visually overlaps. Column spans      */
/*  alone can't overlap: `gridAutoFlow: "dense"` lets the browser pack      */
/*  panels into any gaps automatically, and each row's height still auto-  */
/*  sizes to whatever's tallest in it, so nothing is ever cut off or       */
/*  drawn on top of something else. That's the deliberate trade here —     */
/*  varied WIDTHS or vary the CSS Grid is safe, guessed pixel HEIGHTS are  */
/*  not.                                                                    */
/*                                                                          */
/*  `alignItems: "start"` means a panel only takes its own natural height  */
/*  — it never gets stretched to match a taller neighbor sharing its row.  */
/*                                                                          */
/*  DEMAND/TIME DEPOSITS + LOAN DISTRIBUTION — these three now render      */
/*  through DateWiseBarPanel (multi-date, drill-downable, bar/line         */
/*  toggle), driven by the local bankingData.json mock rather than         */
/*  `data.demandDeposits`/`termDeposits`/`loansBreakdown` from the real    */
/*  API — that API doesn't return multi-date data yet. Swap the import     */
/*  below for a real fetch once it does; DateWiseBarPanel itself doesn't   */
/*  care where its `section` prop comes from.                             */
/* ---------------------------------------------------------------------- */

import React, { useState } from "react";
import { Box, Stack, Typography } from "@mui/material";
import AccountBalanceRoundedIcon from "@mui/icons-material/AccountBalanceRounded";
import AccountBalanceWalletRoundedIcon from "@mui/icons-material/AccountBalanceWalletRounded";
import DescriptionRoundedIcon from "@mui/icons-material/DescriptionRounded";
import TrendingUpRoundedIcon from "@mui/icons-material/TrendingUpRounded";
import { textPrimarySx, textSecondarySx } from "./common";
import HeatTree from "./HeatTree";
import Gauge from "./Gauge";
import DateWiseBarPanel from "./DateWiseBarPanel";
import bankingDataMock from "./bankingData.json";

/** Looks up one section from the mock array by its `key` — swap this for
 * a real fetch result when a multi-date endpoint exists; DateWiseBarPanel
 * only cares about the { title, products, data } shape, not where it
 * came from. */
function bankingSection(key) {
  return bankingDataMock.find((s) => s.key === key);
}

/** Page title/subtitle. Only used once, kept inline rather than as its
 * own file. */
function DashboardHeader({ config }) {
  return (
    <Stack
      direction={{ xs: "column", lg: "row" }}
      alignItems={{ xs: "flex-start", lg: "center" }}
      justifyContent="space-between"
      spacing={2}
      sx={{ px: 0.5 }}
    >
      <Box>
        <Typography sx={{ ...textPrimarySx, fontSize: { xs: 20, md: 24 }, fontWeight: 700 }}>
          {config.title}
        </Typography>
        {config.subtitle && (
          <Typography sx={{ ...textSecondarySx, fontSize: 13, mt: 0.25 }}>{config.subtitle}</Typography>
        )}
      </Box>
    </Stack>
  );
}

/** One grid cell. `span` is out of 12 columns on desktop (md+); every
 * panel goes full-width below that so nothing gets squeezed unreadably
 * narrow on small screens. */
function GridItem({ children, span = 12 }) {
  return (
    <Box
      sx={{
        gridColumn: { xs: "1 / -1", sm: "1 / -1", md: `span ${span}` },
      }}
    >
      {children}
    </Box>
  );
}

/**
 * Props:
 *  - data: {
 *      header: { title, subtitle },
 *      casaGauge: { title, subtitle, value: number | null, centerLabel, bands?: { low, high } },
 *      depositsComposition: {
 *        title, subtitle,
 *        items: { name, value, share, type }[],
 *        legend: { name }[],
 *        filterOptions?: string[], activeFilter?: string,
 *      },
 *      demandDeposits: { title, topValue, data: { name, value }[] },
 *      termDeposits:   { title, topValue, data: { name, value }[] },
 *      loansComposition: { title, subtitle, items, legend, filterOptions?, activeFilter? },
 *      loansBreakdown:   { title, topValue, data: { name, value }[] },
 *    }
 *  - fetchDrilldown: optional (categoryName: string) => Promise<{title, subtitle, data} | null>
 *    Currently unused here — Demand/Time Deposits and Loan Distribution now
 *    render through DateWiseBarPanel, which has its own date-level
 *    drill-down (see above) instead. Kept as a prop for backward
 *    compatibility if a future panel needs it.
 */
export default function DepositsLoansDashboard({ data, fetchDrilldown }) {
  const [selectedPanel, setSelectedPanel] = useState(null);

  if (!data) return null;

  return (
    <Box sx={{ display: "flex", flexDirection: "column", gap: 2.5, minHeight: "90vh" }}>
      {/* Header not needed for now — commented out, not deleted. Uncomment
          to bring it back. */}
      {/* <DashboardHeader config={data.header} /> */}

      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: { xs: "1fr", sm: "1fr 1fr", md: "repeat(12, 1fr)" },
          gridAutoFlow: "dense",
          alignItems: "start",
          gap: 2.5,
        }}
      >
        <GridItem span={7}>
          <HeatTree
            config={data.depositsComposition}
            icon={AccountBalanceRoundedIcon}
            gradientDark="#0f3d3e"
            gradientLight="#a7f3d0"
            shareLabel="of deposits"
            panelId="deposits-treemap"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={5}>
          <Gauge
            config={data.casaGauge}
            panelId="casa-gauge"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={5}>
          <HeatTree
            config={data.loansComposition}
            icon={AccountBalanceWalletRoundedIcon}
            gradientDark="#2e2258"
            gradientLight="#efe6fd"
            shareLabel="of loans"
            panelId="loans-treemap"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={7}>
          <DateWiseBarPanel
            icon={TrendingUpRoundedIcon}
            section={bankingSection("loansBreakdown")}
            panelId="loan-distribution-bar"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={6}>
          <DateWiseBarPanel
            icon={DescriptionRoundedIcon}
            section={bankingSection("demandDeposits")}
            panelId="demand-deposits-bar"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={6}>
          <DateWiseBarPanel
            icon={DescriptionRoundedIcon}
            section={bankingSection("timeDeposits")}
            panelId="term-deposits-bar"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>
      </Box>
    </Box>
  );
}
