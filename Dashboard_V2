/* ---------------------------------------------------------------------- */
/*  DateWiseBarPanel.jsx                                                   */
/*  A multi-date panel — replaces the single-snapshot BarPanel for         */
/*  Demand Deposits, Time Deposits, and Loan Distribution. Two things      */
/*  live in this one panel:                                                */
/*                                                                          */
/*  1. OVERVIEW — every date in `section.data`.                            */
/*  2. DRILL-DOWN — click ANY bar/point in the overview and it narrows to   */
/*     that ONE date's breakdown, all categories, with a Back button to    */
/*     return. Every bar/point in a cluster shares the same date, so a     */
/*     click always drills into that date regardless of which one.        */
/*                                                                          */
/*  The icon button in the top-right corner swaps whichever view is        */
/*  currently showing between BAR and LINE rendering.                     */
/*                                                                          */
/*  BAR VIEW = a "Line Bar Area Composed Chart" — grouped bars per          */
/*  category (left axis, unchanged) PLUS a date-wise TOTAL (sum across     */
/*  categories per date) drawn as a filled area + line on its own          */
/*  independent right axis, since it's naturally several times larger      */
/*  than any single category.                                             */
/*                                                                          */
/*  LINE VIEW = genuinely biaxial, but NOT via a separate "Total" line     */
/*  (that moved to the bar view above). Instead, categories are split      */
/*  into two axis groups by magnitude (smallest half -> left axis,         */
/*  largest half -> right axis). This is the actual fix for "looks like a  */
/*  straight/flat line": every category sharing ONE axis scaled to the     */
/*  largest category's range squashes a smaller category's real day-to-   */
/*  day movement down to nothing. Splitting by magnitude lets each axis    */
/*  auto-scale tightly to its own group's actual range, so real movement   */
/*  in EVERY category becomes visible — plus every line now uses a         */
/*  smooth ("monotone") curve instead of straight segments.                */
/*                                                                          */
/*  Drill-down's line view keeps its own biaxial pairing (a category's     */
/*  value on the left, the running cumulative total across categories on  */
/*  the right) — that pairing is unrelated to the overview's and untouched */
/*  by the changes above, just also drawn with smooth curves now.         */
/*                                                                          */
/*  DATA SHAPE — this consumes the "columnar" mock shape directly:         */
/*    { title, products: [{name, type}], data: [{date, values}] }         */
/*  where `values[i]` corresponds to `products[i]`. This is currently      */
/*  wired to the local bankingData.json mock (see DepositsLoansDashboard   */
/*  .jsx) rather than the live API — swap that one import for a real       */
/*  fetch when a multi-date endpoint exists; nothing in this file needs    */
/*  to change since it only cares about the shape above.                  */
/* ---------------------------------------------------------------------- */

import React, { useMemo, useState } from "react";
import { Box, IconButton, Stack, Tooltip, Typography } from "@mui/material";
import { alpha, useTheme } from "@mui/material/styles";
import {
  Area,
  Bar,
  ComposedChart,
  CartesianGrid,
  Cell,
  Line,
  LineChart as RechartsLineChart,
  ResponsiveContainer,
  Tooltip as RechartsTooltip,
  XAxis,
  YAxis,
} from "recharts";
import ShowChartRoundedIcon from "@mui/icons-material/ShowChartRounded";
import BarChartRoundedIcon from "@mui/icons-material/BarChartRounded";
import { glass } from "../../theme/themePrimitives"; // adjust path to match your project structure
import { GlassPanel, PanelHeader, BackButton, RADIUS, textSecondarySx } from "./common";
import { getColor, formatAmount } from "./utils";

const TOTAL_COLOR = "#eb6834"; // the date-wise Total's fixed accent color, in the bar/composed view only

/** "2026-09-17" -> "17-Sep", matching the reference screenshot's axis
 * label style. Falls back to the raw string if it doesn't parse (never
 * throws on unexpected date formats). */
function formatDateLabel(isoDate) {
  const d = new Date(isoDate);
  if (Number.isNaN(d.getTime())) return isoDate;
  return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short" }).replace(" ", "-");
}

/** Custom line-chart dot that's actually clickable — recharts' `dot={{onClick}}`
 * shorthand isn't a reliably documented event shape across versions; a
 * custom render function is the well-documented way to get direct access
 * to this point's own data row (including __isoDate) with no guessing. */
function ClickableDot({ cx, cy, payload, fill, radius, onDotClick }) {
  if (cx == null || cy == null) return null;
  return (
    <circle
      cx={cx}
      cy={cy}
      r={radius}
      fill={fill}
      stroke="none"
      style={{ cursor: onDotClick ? "pointer" : "default" }}
      onClick={
        onDotClick
          ? (e) => {
              e.stopPropagation();
              onDotClick(payload.__isoDate);
            }
          : undefined
      }
    />
  );
}

/** Small icon button, top-right, swapping the current view between bar
 * and line — independent of whether that view is the overview or a
 * drill-down. */
function ChartTypeToggle({ chartType, onToggle }) {
  const isLine = chartType === "line";
  return (
    <Tooltip title={isLine ? "Switch to bar chart" : "Switch to line chart"}>
      <IconButton
        size="small"
        onClick={(e) => {
          e.stopPropagation();
          onToggle();
        }}
      >
        {isLine ? <BarChartRoundedIcon fontSize="small" /> : <ShowChartRoundedIcon fontSize="small" />}
      </IconButton>
    </Tooltip>
  );
}

/** Custom tooltip for the overview (multi-date) chart — lists every
 * category's value, plus the date-wise Total when present, for the
 * hovered date. Works for both the composed bar view and the line view,
 * since it just lists whatever series are actually in `payload`. */
function OverviewTooltip({ active, payload, label, theme }) {
  if (!active || !payload || !payload.length) return null;
  // The composed bar view draws "Total" as both an Area (fill) and a Line
  // (crisp stroke) sharing the same dataKey, so it appears twice in the
  // raw payload — keep only the first occurrence of each series.
  const seen = new Set();
  const uniquePayload = payload.filter((p) => {
    if (seen.has(p.dataKey)) return false;
    seen.add(p.dataKey);
    return true;
  });
  return (
    <Box
      sx={{
        background: glass.panel(0.92),
        backdropFilter: "blur(16px) saturate(160%)",
        border: `1px solid ${glass.border}`,
        borderRadius: RADIUS.sm,
        px: 1.5,
        py: 1,
        boxShadow: theme.shadows[8],
        maxWidth: 220,
      }}
    >
      <Typography sx={{ fontSize: 11.5, fontWeight: 600, color: "text.secondary", mb: 0.5 }}>{label}</Typography>
      {uniquePayload.map((p) => (
        <Stack key={p.dataKey} direction="row" spacing={0.75} alignItems="center" sx={{ mb: 0.25 }}>
          <Box sx={{ width: 7, height: 7, borderRadius: "2px", bgcolor: p.color, flexShrink: 0 }} />
          <Typography sx={{ fontSize: 11.5, color: "text.primary" }} noWrap>
            {p.dataKey}: <b>{formatAmount(p.value)}</b>
          </Typography>
        </Stack>
      ))}
    </Box>
  );
}

/** Custom tooltip for the drill-down (single-date) chart — shows the
 * category's own value (left axis) and, when present, the running
 * cumulative total (right axis, line view only). */
function DrilldownTooltip({ active, payload, label, theme }) {
  if (!active || !payload || !payload.length) return null;
  const valuePoint = payload.find((p) => p.dataKey === "value");
  const cumulativePoint = payload.find((p) => p.dataKey === "cumulative");
  return (
    <Box
      sx={{
        background: glass.panel(0.92),
        backdropFilter: "blur(16px) saturate(160%)",
        border: `1px solid ${glass.border}`,
        borderRadius: RADIUS.sm,
        px: 1.5,
        py: 1,
        boxShadow: theme.shadows[8],
      }}
    >
      <Typography sx={{ fontSize: 11.5, fontWeight: 600, color: "text.secondary" }}>{label}</Typography>
      {valuePoint && (
        <Typography sx={{ fontSize: 14, fontWeight: 800, color: valuePoint.payload.__color }}>
          {formatAmount(valuePoint.value)}
        </Typography>
      )}
      {cumulativePoint && (
        <Typography sx={{ fontSize: 11.5, fontWeight: 600, color: TOTAL_COLOR }}>
          Running total: {formatAmount(cumulativePoint.value)}
        </Typography>
      )}
    </Box>
  );
}

/**
 * Props:
 *  - section: { title, products: {name, type}[], data: {date, values: number[]}[] }
 *    (matches bankingData.json's per-section shape exactly)
 *  - icon: MUI icon component for the panel header
 *  - onDrilldownChange: optional (date: string | null) => void, fired
 *    whenever the drill-down state changes — lets a parent know without
 *    lifting the whole state up.
 *  - panelId / selectedPanel / onSelectPanel: optional click-to-highlight
 *    wiring, shared with every other panel (see GlassPanel in common.jsx).
 */
export default function DateWiseBarPanel({ section, icon, onDrilldownChange, panelId, selectedPanel, onSelectPanel }) {
  const theme = useTheme();
  const [chartType, setChartType] = useState("bar"); // "bar" | "line" — applies to whichever view is active
  const [selectedDate, setSelectedDate] = useState(null); // null = overview, else the drilled-into date

  // Defensive fallback — with real network data, `section` can briefly be
  // undefined (still loading, or this key wasn't in the response) instead
  // of always synchronously present like the old bankingData.json mock
  // was. Every hook below still needs to run every render (Rules of
  // Hooks), so it runs against this safe empty shape; the actual "no
  // data" message is rendered further down, after all hooks have run.
  const safeTitle = section?.title || "";
  const products = Array.isArray(section?.products) ? section.products : [];
  const dataRows = Array.isArray(section?.data) ? section.data : [];

  const gridStrokeColor = alpha(theme.palette.text.primary, 0.08);

  // One consistent color per PRODUCT (category), by its fixed position in
  // the products list — never by date or render order, so a category's
  // color never shifts between the overview and a drill-down.
  const colorForProduct = useMemo(() => {
    const map = new Map(products.map((p, i) => [p.name, getColor(p.name, i, theme)]));
    return (name) => map.get(name) || getColor(name, 0, theme);
  }, [products, theme]);

  // NEW: splits categories into a "left axis" and "right axis" group by
  // magnitude (using each category's most recent value) — this is what
  // makes the overview LINE view genuinely biaxial, and is the actual fix
  // for lines looking flat: one shared axis scaled to the largest
  // category flattens a smaller category's real day-to-day movement.
  const axisGroupFor = useMemo(() => {
    const latest = products.map((p, i) => ({
      name: p.name,
      value: dataRows[dataRows.length - 1]?.values[i] ?? 0,
    }));
    const sorted = [...latest].sort((a, b) => a.value - b.value);
    const mid = Math.ceil(sorted.length / 2);
    const map = new Map(sorted.map((item, idx) => [item.name, idx < mid ? "left" : "right"]));
    return (name) => map.get(name) || "left";
  }, [products, dataRows]);

  // Overview rows: one object per date, with each product's value keyed
  // by its own name — the shape Recharts' multi-series Bar/Line chart
  // wants (one <Bar>/<Line> per key) — plus a "Total" (sum across
  // products) for the composed bar view's right axis.
  const overviewRows = useMemo(
    () =>
      dataRows.map((row) => {
        const entry = { date: formatDateLabel(row.date), __isoDate: row.date };
        products.forEach((p, i) => {
          entry[p.name] = row.values[i];
        });
        entry.Total = row.values.reduce((sum, v) => sum + v, 0);
        return entry;
      }),
    [dataRows, products],
  );

  // Drill-down rows: the single selected date's products, reshaped into
  // the flat { name, value, __color } list the rest of the dashboard's
  // single-series charts already use — plus a running "cumulative" total
  // across categories (in the given product order) for the line view's
  // right axis.
  const drilldownRows = useMemo(() => {
    if (!selectedDate) return [];
    const row = dataRows.find((d) => d.date === selectedDate);
    if (!row) return [];
    let running = 0;
    return products.map((p, i) => {
      running += row.values[i];
      return {
        name: p.name,
        value: row.values[i],
        cumulative: running,
        __color: colorForProduct(p.name),
      };
    });
  }, [selectedDate, dataRows, products, colorForProduct]);

  const handleDrillInto = (isoDate) => {
    setSelectedDate(isoDate);
    onDrilldownChange?.(isoDate);
  };

  const handleBack = () => {
    setSelectedDate(null);
    onDrilldownChange?.(null);
  };

  const isDrilldown = Boolean(selectedDate);
  const drilldownLabel = isDrilldown ? formatDateLabel(selectedDate) : null;

  // No section for this key yet (still loading, or missing from the
  // response) — show a lightweight placeholder instead of crashing on
  // products/data that don't exist. Same GlassPanel/PanelHeader shell and
  // text style as the rest of the dashboard, so it doesn't look like a
  // different kind of thing.
  if (!section) {
    return (
      <GlassPanel sx={{ p: 3 }} selected={selectedPanel === panelId} onClick={() => onSelectPanel?.(panelId)}>
        <PanelHeader icon={icon} title={safeTitle || "—"} />
        <Typography sx={{ ...textSecondarySx, fontSize: 12.5 }}>No data available.</Typography>
      </GlassPanel>
    );
  }

  return (
    <GlassPanel sx={{ p: 3 }} selected={selectedPanel === panelId} onClick={() => onSelectPanel?.(panelId)}>
      <PanelHeader
        icon={icon}
        title={isDrilldown ? `${safeTitle} — ${drilldownLabel}` : safeTitle}
        action={
          <Stack direction="row" spacing={0.5} alignItems="center">
            {isDrilldown && <BackButton onBack={handleBack} />}
            <ChartTypeToggle chartType={chartType} onToggle={() => setChartType((v) => (v === "bar" ? "line" : "bar"))} />
          </Stack>
        }
      />
      {!isDrilldown && (
        <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>
          Click any bar to see that date's breakdown
        </Typography>
      )}

      <Box sx={{ width: "100%", height: 260, "& svg:focus, & svg *:focus": { outline: "none" } }}>
        <ResponsiveContainer>
          {isDrilldown ? (
            chartType === "line" ? (
              <RechartsLineChart data={drilldownRows} margin={{ top: 20, right: 8, left: -4, bottom: 6 }}>
                <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
                <XAxis dataKey="name" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={38} />
                <YAxis yAxisId="left" tick={{ fontSize: 11, fill: theme.palette.primary.main }} axisLine={false} tickLine={false} width={32} />
                <YAxis yAxisId="right" orientation="right" tick={{ fontSize: 11, fill: TOTAL_COLOR }} axisLine={false} tickLine={false} width={36} />
                <RechartsTooltip content={(props) => <DrilldownTooltip {...props} theme={theme} />} />
                <Line
                  yAxisId="left"
                  type="monotone"
                  dataKey="value"
                  name="Value"
                  stroke={theme.palette.primary.main}
                  strokeWidth={2}
                  dot={{ r: 3, fill: theme.palette.primary.main, strokeWidth: 0 }}
                  isAnimationActive={false}
                />
                <Line
                  yAxisId="right"
                  type="monotone"
                  dataKey="cumulative"
                  name="Running total"
                  stroke={TOTAL_COLOR}
                  strokeWidth={2}
                  dot={{ r: 3, fill: TOTAL_COLOR, strokeWidth: 0 }}
                  isAnimationActive={false}
                />
              </RechartsLineChart>
            ) : (
              <ComposedChart data={drilldownRows} margin={{ top: 20, right: 16, left: -4, bottom: 6 }} barCategoryGap="32%">
                <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
                <XAxis dataKey="name" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={38} />
                <YAxis tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={32} />
                <RechartsTooltip cursor={{ fill: alpha(theme.palette.text.primary, 0.05) }} content={(props) => <DrilldownTooltip {...props} theme={theme} />} />
                <Bar dataKey="value" radius={[6, 6, 0, 0]} maxBarSize={40}>
                  {drilldownRows.map((d) => (
                    <Cell key={d.name} fill={d.__color} />
                  ))}
                </Bar>
              </ComposedChart>
            )
          ) : chartType === "line" ? (
            <RechartsLineChart data={overviewRows} margin={{ top: 20, right: 8, left: -4, bottom: 6 }}>
              <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
              <XAxis dataKey="date" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={30} />
              <YAxis yAxisId="left" tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={32} />
              <YAxis yAxisId="right" orientation="right" tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={36} />
              <RechartsTooltip content={(props) => <OverviewTooltip {...props} theme={theme} />} />
              {products.map((p) => (
                <Line
                  key={p.name}
                  yAxisId={axisGroupFor(p.name)}
                  type="monotone"
                  dataKey={p.name}
                  stroke={colorForProduct(p.name)}
                  strokeWidth={2}
                  dot={(dotProps) => (
                    <ClickableDot key={dotProps.payload.__isoDate} {...dotProps} fill={colorForProduct(p.name)} radius={3} onDotClick={handleDrillInto} />
                  )}
                  activeDot={(dotProps) => (
                    <ClickableDot key={`active-${dotProps.payload.__isoDate}`} {...dotProps} fill={colorForProduct(p.name)} radius={5} onDotClick={handleDrillInto} />
                  )}
                  isAnimationActive={false}
                />
              ))}
            </RechartsLineChart>
          ) : (
            <ComposedChart data={overviewRows} margin={{ top: 20, right: 8, left: -4, bottom: 6 }} barCategoryGap="20%" barGap={2}>
              <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
              <XAxis dataKey="date" tick={{ fontSize: 10, fill: theme.palette.text.secondary }} axisLine={{ stroke: gridStrokeColor }} tickLine={false} interval={0} height={30} />
              <YAxis yAxisId="left" tick={{ fontSize: 11, fill: theme.palette.text.secondary }} axisLine={false} tickLine={false} width={32} />
              <YAxis yAxisId="right" orientation="right" tick={{ fontSize: 11, fill: TOTAL_COLOR }} axisLine={false} tickLine={false} width={36} />
              <RechartsTooltip cursor={{ fill: alpha(theme.palette.text.primary, 0.05) }} content={(props) => <OverviewTooltip {...props} theme={theme} />} />
              {products.map((p) => (
                <Bar
                  key={p.name}
                  yAxisId="left"
                  dataKey={p.name}
                  fill={colorForProduct(p.name)}
                  radius={[3, 3, 0, 0]}
                  maxBarSize={18}
                  cursor="pointer"
                  onClick={(data) => handleDrillInto(data.__isoDate)}
                />
              ))}
              <Area
                yAxisId="right"
                type="monotone"
                dataKey="Total"
                name="Total"
                fill={TOTAL_COLOR}
                fillOpacity={0.12}
                stroke="none"
                isAnimationActive={false}
              />
              <Line
                yAxisId="right"
                type="monotone"
                dataKey="Total"
                name="Total"
                stroke={TOTAL_COLOR}
                strokeWidth={2}
                dot={(dotProps) => <ClickableDot key={`total-${dotProps.payload.__isoDate}`} {...dotProps} fill={TOTAL_COLOR} radius={3} onDotClick={handleDrillInto} />}
                isAnimationActive={false}
              />
            </ComposedChart>
          )}
        </ResponsiveContainer>
      </Box>

      <Box sx={{ mt: 1.5, display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(120px, 1fr))", rowGap: 0.75, columnGap: 1.5 }}>
        {products.map((p) => (
          <Stack key={p.name} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "2px", bgcolor: colorForProduct(p.name), flexShrink: 0 }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11, fontWeight: 500 }} noWrap>
              {p.name}
            </Typography>
          </Stack>
        ))}
        {!isDrilldown && chartType === "bar" && (
          <Stack direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "2px", bgcolor: TOTAL_COLOR, flexShrink: 0 }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11, fontWeight: 500 }} noWrap>
              Total (right axis)
            </Typography>
          </Stack>
        )}
      </Box>
    </GlassPanel>
  );
}

