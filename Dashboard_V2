/* ---------------------------------------------------------------------- */
/*  trendApi.js                                                            */
/*  Everything related to the GET /DS/dashboard/trend-data endpoint lives  */
/*  here — the endpoint path, and mapTrendDataToSections(), which turns    */
/*  the raw API response into the exact { key, title, products, data }[]  */
/*  shape DateWiseBarPanel already consumes (matches bankingData.json's    */
/*  shape exactly, so DateWiseBarPanel itself needs no changes).           */
/*                                                                          */
/*  SECURITY / ROBUSTNESS — same reasoning as mapApiToDashboardData.js:    */
/*  this is the one place this endpoint's raw, untrusted response gets     */
/*  validated before anything else sees it. Every field is type-checked    */
/*  and range-clamped so a malformed response can never crash the          */
/*  dashboard — a bad section is dropped rather than throwing.            */
/* ---------------------------------------------------------------------- */

import { normalizeDepositName } from "./utils";

export const TREND_DATA_ENDPOINT = "/DS/dashboard/trend-data";

/** Coerces `raw` into a finite, non-negative number, or 0 if it can't be
 * trusted (missing, wrong type, NaN, negative). Deposit/loan amounts are
 * never legitimately negative, and a stray negative/NaN would otherwise
 * corrupt everything downstream — date-wise totals, axis scaling, the
 * sqrt-based sizing elsewhere in the dashboard. */
function toSafeAmount(raw) {
  const n = Number(raw);
  return Number.isFinite(n) && n >= 0 ? n : 0;
}

function mapProducts(rawProducts) {
  if (!Array.isArray(rawProducts)) return [];
  return rawProducts
    .filter((p) => p && typeof p === "object")
    .map((p) => ({
      name: normalizeDepositName(p.name),
      type: String(p.type || "").replace(/\s+/g, " ").trim(),
    }));
}

/** Every data row's `values` array must line up 1:1 with `products` —
 * pads a short row with 0s and drops extra entries from a long one,
 * rather than trusting the API to always send a matching length. */
function mapDataRows(rawData, expectedLength) {
  if (!Array.isArray(rawData)) return [];
  return rawData
    .filter((row) => row && typeof row === "object" && typeof row.date === "string")
    .map((row) => {
      const rawValues = Array.isArray(row.values) ? row.values : [];
      const values = Array.from({ length: expectedLength }, (_, i) => toSafeAmount(rawValues[i]));
      return { date: row.date, values };
    });
}

/** One section: { key, title, products, data } — exactly matching what
 * DateWiseBarPanel/bankingData.json already use. */
function mapSection(rawSection) {
  if (!rawSection || typeof rawSection !== "object") return null;
  const products = mapProducts(rawSection.products);
  return {
    key: typeof rawSection.key === "string" ? rawSection.key : "",
    title: typeof rawSection.title === "string" ? rawSection.title : "",
    products,
    data: mapDataRows(rawSection.data, products.length),
  };
}

/**
 * @param {unknown} rawResponseData — the raw `response.data` array from
 *   GET /DS/dashboard/trend-data (an array of sections).
 * @returns { key, title, products, data }[] — same shape as
 *   bankingData.json, safe to pass straight into DateWiseBarPanel. Never
 *   throws; a malformed section is simply dropped rather than crashing
 *   the whole page.
 */
export function mapTrendDataToSections(rawResponseData) {
  if (!Array.isArray(rawResponseData)) return [];
  return rawResponseData.map(mapSection).filter(Boolean);
}















/* ---------------------------------------------------------------------- */
/*  DashboardPage.jsx — main entry point / the ONE place the real API      */
/*  gets wired in.                                                        */
/*  Uses the project's existing `useApi` hook to fetch TWO independent      */
/*  endpoints once on mount:                                              */
/*   - /DS/dashboard/dashboard-data — the static snapshot (heatmap tiles,   */
/*     CASA ratio), mapped by mapApiToDashboardData.js.                    */
/*   - /DS/dashboard/trend-data — the 7-day date-wise data behind the       */
/*     Demand/Time Deposits and Loan Distribution panels, mapped by         */
/*     trendApi.js's mapTrendDataToSections().                            */
/*  Each fetch has its own independent loading/error state (two separate   */
/*  useApi() instances — sharing one would mix up their results), but the  */
/*  page waits for BOTH before rendering the dashboard, and surfaces        */
/*  either one's error the same way — this keeps the existing loading/     */
/*  error UI and overall page behavior unchanged, just gated on two        */
/*  fetches instead of one.                                               */
/*  No component under DepositsLoansDashboard knows an API exists — this   */
/*  is the only file that needs to change if either endpoint, auth, or      */
/*  response shape changes. Mount this file directly as your route/page.   */
/* ---------------------------------------------------------------------- */

import React, { useEffect, useMemo } from "react";
import { Box, Button, CircularProgress, Typography } from "@mui/material";
import useApi from "../../hooks/useApi"; // adjust path to match your project structure
import DepositsLoansDashboard from "./DepositsLoansDashboard";
import mapApiToDashboardData from "./MapApiToDashboardData";
import { mapTrendDataToSections, TREND_DATA_ENDPOINT } from "./trendApi";
import { textSecondarySx } from "./common";

const DASHBOARD_ENDPOINT = "/DS/dashboard/dashboard-data";

export default function DashboardPage() {
  const { data: apiResponse, error, loading, callApi } = useApi();
  const { data: trendResponse, error: trendError, loading: trendLoading, callApi: callTrendApi } = useApi();

  useEffect(() => {
    // Both fetches fire in parallel — neither waits on the other, since
    // they're two independent endpoints feeding two independent parts of
    // the page.
    callApi(DASHBOARD_ENDPOINT).catch(() => {
      // Swallow here — `error` from useApi already captures it below, and
      // callApi's own catch already logs the underlying error.
    });
    callTrendApi(TREND_DATA_ENDPOINT).catch(() => {
      // Same as above, for the trend fetch.
    });
    // Only fetch once on mount.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // The actual dashboard content is nested one level in:
  // response.data.staticDashboardData[0]. mapApiToDashboardData does all
  // the shape translation + derived calculations (share %, topValue, ...).
  const dashboardData = useMemo(() => {
    const section = apiResponse?.data?.staticDashboardData?.[0];
    return mapApiToDashboardData(section);
  }, [apiResponse]);

  // trend-data's envelope is simpler: response.data is directly the array
  // of { key, title, products, data } sections.
  const trendSections = useMemo(() => mapTrendDataToSections(trendResponse?.data), [trendResponse]);

  const isLoading = (loading || trendLoading) && !dashboardData;
  const hasError = error || trendError;

  if (isLoading) {
    return (
      <Box sx={{ display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", minHeight: "60vh", gap: 2 }}>
        <CircularProgress />
        <Typography sx={textSecondarySx}>Loading dashboard…</Typography>
      </Box>
    );
  }

  if (hasError) {
    const failedMessage =
      error?.response?.data?.message ||
      error?.message ||
      trendError?.response?.data?.message ||
      trendError?.message ||
      "Something went wrong while fetching data.";
    return (
      <Box sx={{ display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", minHeight: "60vh", gap: 2, textAlign: "center", px: 3 }}>
        <Typography sx={{ fontWeight: 700 }}>Couldn't load the dashboard</Typography>
        <Typography sx={textSecondarySx}>{failedMessage}</Typography>
        <Button
          variant="contained"
          onClick={() => {
            callApi(DASHBOARD_ENDPOINT);
            callTrendApi(TREND_DATA_ENDPOINT);
          }}
        >
          Retry
        </Button>
      </Box>
    );
  }

  if (!dashboardData) {
    return (
      <Box sx={{ display: "flex", alignItems: "center", justifyContent: "center", minHeight: "60vh" }}>
        <Typography sx={textSecondarySx}>No dashboard data available.</Typography>
      </Box>
    );
  }

  // No `fetchDrilldown` passed — there's currently no drill-down endpoint,
  // so every bar renders display-only until one exists (see BarPanel.jsx).
  return <DepositsLoansDashboard data={dashboardData} trendSections={trendSections} />;
}

















