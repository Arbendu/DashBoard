/* ---------------------------------------------------------------------- */
/*  DepositsLoansDashboard.jsx — root component                            */
/*  Purely presentational/compositional. Every number on screen comes      */
/*  from the `data` prop, every drill-down from `fetchDrilldown`. Nothing  */
/*  is imported or hardcoded here — see DashboardPage.jsx for how the real */
/*  API's response gets mapped into this shape (mapApiToDashboardData.js). */
/*                                                                          */
/*  LAYOUT — CSS Grid with hand-assigned COLUMN spans per panel (see       */
/*  GridItem below), not CSS multi-column masonry. Masonry always stacks   */
/*  items strictly top-to-bottom within whichever column has the least     */
/*  content — every item still belongs to exactly one column. This grid    */
/*  instead gives each panel an explicit WIDTH (2, 3, or 4 of 12 columns), */
/*  so the arrangement doesn't read as a uniform repeating pattern.        */
/*                                                                          */
/*  WHY NOT ROW SPANS TOO — a bento layout with one tall panel that two    */
/*  short ones tuck in beside (like a stock dashboard mockup) needs each   */
/*  panel's ROW span to match its actual rendered height in pixels. Get    */
/*  that even slightly wrong and CSS Grid does NOT reflow around it —     */
/*  content from two different panels visually overlaps. Column spans      */
/*  alone can't overlap: `gridAutoFlow: "dense"` lets the browser pack      */
/*  panels into any gaps automatically, and each row's height still auto-  */
/*  sizes to whatever's tallest in it, so nothing is ever cut off or       */
/*  drawn on top of something else. That's the deliberate trade here —     */
/*  varied WIDTHS or vary the CSS Grid is safe, guessed pixel HEIGHTS are  */
/*  not.                                                                    */
/*                                                                          */
/*  `alignItems: "start"` means a panel only takes its own natural height  */
/*  — it never gets stretched to match a taller neighbor sharing its row.  */
/* ---------------------------------------------------------------------- */

import React, { useState } from "react";
import { Box, Stack, Typography } from "@mui/material";
import AccountBalanceRoundedIcon from "@mui/icons-material/AccountBalanceRounded";
import AccountBalanceWalletRoundedIcon from "@mui/icons-material/AccountBalanceWalletRounded";
import DescriptionRoundedIcon from "@mui/icons-material/DescriptionRounded";
import TrendingUpRoundedIcon from "@mui/icons-material/TrendingUpRounded";
import { textPrimarySx, textSecondarySx } from "./common";
import HeatTree from "./HeatTree";
import Gauge from "./Gauge";
import BarPanel from "./BarPanel";

/** Page title/subtitle. Only used once, kept inline rather than as its
 * own file. */
function DashboardHeader({ config }) {
  return (
    <Stack
      direction={{ xs: "column", lg: "row" }}
      alignItems={{ xs: "flex-start", lg: "center" }}
      justifyContent="space-between"
      spacing={2}
      sx={{ px: 0.5 }}
    >
      <Box>
        <Typography sx={{ ...textPrimarySx, fontSize: { xs: 20, md: 24 }, fontWeight: 700 }}>
          {config.title}
        </Typography>
        {config.subtitle && (
          <Typography sx={{ ...textSecondarySx, fontSize: 13, mt: 0.25 }}>{config.subtitle}</Typography>
        )}
      </Box>
    </Stack>
  );
}

/** One grid cell. `span` is out of 12 columns on desktop (md+); every
 * panel goes full-width below that so nothing gets squeezed unreadably
 * narrow on small screens. */
function GridItem({ children, span = 12 }) {
  return (
    <Box
      sx={{
        gridColumn: { xs: "1 / -1", sm: "1 / -1", md: `span ${span}` },
      }}
    >
      {children}
    </Box>
  );
}

/**
 * Props:
 *  - data: {
 *      header: { title, subtitle },
 *      casaGauge: { title, subtitle, value: number | null, centerLabel, bands?: { low, high } },
 *      depositsComposition: {
 *        title, subtitle,
 *        items: { name, value, share, type }[],
 *        legend: { name }[],
 *        filterOptions?: string[], activeFilter?: string,
 *      },
 *      demandDeposits: { title, topValue, data: { name, value }[] },
 *      termDeposits:   { title, topValue, data: { name, value }[] },
 *      loansComposition: { title, subtitle, items, legend, filterOptions?, activeFilter? },
 *      loansBreakdown:   { title, topValue, data: { name, value }[] },
 *    }
 *  - fetchDrilldown: optional (categoryName: string) => Promise<{title, subtitle, data} | null>
 *    Passed straight through to every BarPanel. Omit it to make every bar
 *    chart purely display-only (no drill-down) — there's currently no
 *    drill-down endpoint, so callers should omit this for now.
 */
export default function DepositsLoansDashboard({ data, fetchDrilldown }) {
  const [selectedPanel, setSelectedPanel] = useState(null);

  if (!data) return null;

  return (
    <Box sx={{ display: "flex", flexDirection: "column", gap: 2.5, minHeight: "90vh" }}>
      {/* Header not needed for now — commented out, not deleted. Uncomment
          to bring it back. */}
      {/* <DashboardHeader config={data.header} /> */}

      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: { xs: "1fr", sm: "1fr 1fr", md: "repeat(12, 1fr)" },
          gridAutoFlow: "dense",
          alignItems: "start",
          gap: 2.5,
        }}
      >
        <GridItem span={7}>
          <HeatTree
            config={data.depositsComposition}
            icon={AccountBalanceRoundedIcon}
            gradientDark="#0f3d3e"
            gradientLight="#a7f3d0"
            shareLabel="of deposits"
            panelId="deposits-treemap"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={5}>
          <Gauge
            config={data.casaGauge}
            panelId="casa-gauge"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={5}>
          <HeatTree
            config={data.loansComposition}
            icon={AccountBalanceWalletRoundedIcon}
            gradientDark="#2e2258"
            gradientLight="#efe6fd"
            shareLabel="of loans"
            panelId="loans-treemap"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={7}>
          <BarPanel
            icon={TrendingUpRoundedIcon}
            config={data.loansBreakdown}
            titleOverride="Loan Distribution"
            fetchDrilldown={fetchDrilldown}
            panelId="loan-distribution-bar"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={6}>
          <BarPanel
            icon={DescriptionRoundedIcon}
            config={data.demandDeposits}
            fetchDrilldown={fetchDrilldown}
            panelId="demand-deposits-bar"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>

        <GridItem span={6}>
          <BarPanel
            icon={DescriptionRoundedIcon}
            config={data.termDeposits}
            fetchDrilldown={fetchDrilldown}
            panelId="term-deposits-bar"
            selectedPanel={selectedPanel}
            onSelectPanel={setSelectedPanel}
          />
        </GridItem>
      </Box>
    </Box>
  );
}













/* ---------------------------------------------------------------------- */
/*  HeatTree.jsx                                                           */
/*  A real, area-filling treemap — like the Recharts "Bundle Size          */
/*  Treemap" reference: rectangles are sized so their AREA is exactly      */
/*  proportional to value, and together they fill 100% of the space with   */
/*  no gaps.                                                               */
/*                                                                          */
/*  COLOR — back to a clean per-SECTION dark→light gradient (one hue       */
/*  family per HeatTree instance — teal for Deposits, purple for Loans —   */
/*  set via `gradientDark`/`gradientLight` props from                     */
/*  DepositsLoansDashboard.jsx), value-driven: the largest item in the     */
/*  set renders darkest, the smallest lightest. This replaced an earlier   */
/*  version that used a fixed 8-color categorical palette (a different hue */
/*  per tile) — reverted because the single-gradient-per-section look is   */
/*  what was actually wanted. Color is keyed by NAME (not sort position    */
/*  or render order) so a category's shade never shifts between the       */
/*  treemap and the legend.                                                */
/*                                                                          */
/*  LAYOUT — `buildTreemap` (utils.js) does the actual math: a recursive   */
/*  "slice and dice" split (the standard treemap algorithm — same idea     */
/*  D3/Excel/Power BI treemaps use). It returns each item's box as         */
/*  { x, y, w, h } in PERCENT of the container, positioned here with       */
/*  `position: absolute`.                                                  */
/*                                                                          */
/*  NO TEXT OVERLAP — small tiles naturally can't fit a full label, so     */
/*  they degrade to a value-only line, then to a bare color swatch, as a   */
/*  tile shrinks (see the reference image: its smallest cells are just a   */
/*  color swatch, no label). `minWidth: 0` + `overflow: hidden` on every   */
/*  tile is what guarantees text can never force a tile wider than its     */
/*  assigned box or spill into its neighbor.                              */
/* ---------------------------------------------------------------------- */

import React, { useMemo, useState } from "react";
import { Box, Stack, Typography } from "@mui/material";
import { useTheme } from "@mui/material/styles";
import Inventory2RoundedIcon from "@mui/icons-material/Inventory2Rounded";
import { GlassPanel, PanelHeader, MiniSelect, RADIUS, textSecondarySx } from "./common";
import { heatColor, mixHex, getColor, buildTreemap, formatAmount } from "./utils";

/** A single treemap cell, positioned by percent within the container. */
function Tile({ item, x, y, w, h, color, shareLabel, onClick }) {
  const theme = useTheme();
  const fg = theme.palette.getContrastText(color);
  const sheen = mixHex(color, "#ffffff", 0.16);

  // Tiny tiles can't fit a name + amount + share line — the reference
  // treemap just shows a bare color swatch for its smallest cells, so we
  // follow the same pattern instead of forcing text to overflow.
  const showFull = w >= 14 && h >= 16;
  const showValueOnly = !showFull && w >= 7 && h >= 9;

  return (
    <Box
      sx={{
        position: "absolute",
        left: `${x}%`,
        top: `${y}%`,
        width: `${w}%`,
        height: `${h}%`,
        p: 0.25, // thin gap between tiles, matching the reference's grid look
        boxSizing: "border-box",
      }}
    >
      <Box
        role={onClick ? "button" : undefined}
        tabIndex={onClick ? 0 : undefined}
        onClick={onClick}
        sx={{
          width: "100%",
          height: "100%",
          minWidth: 0, // prevents un-wrapped text from forcing this box wider than its %
          minHeight: 0,
          //borderRadius: RADIUS.sm,
          p: showFull ? 1.25 : 0.75,
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          overflow: "hidden", // hard clip — a tile can never visually escape its assigned box
          cursor: onClick ? "pointer" : "default",
          background: `linear-gradient(135deg, ${sheen} 0%, ${color} 55%)`,
          color: fg,
          transition: "transform 0.15s ease, box-shadow 0.15s ease",
          "&:hover": {
            transform: "scale(1.015)",
            boxShadow: theme.shadows[6],
            zIndex: 1,
          },
        }}
      >
        {showFull && (
          <Typography
            sx={{
              fontFamily: theme.typography.fontFamily,
              fontSize: 13,
              fontWeight: 600,
              opacity: 0.92,
              lineHeight: 1.25,
            }}
            noWrap
          >
            {item.name}
          </Typography>
        )}
        {(showFull || showValueOnly) && (
          <Box sx={{ minWidth: 0 }}>
            <Typography
              sx={{
                fontFamily: theme.typography.fontFamily,
                fontSize: showFull ? 18 : 11,
                fontWeight: 700,
                lineHeight: 1.2,
              }}
              noWrap
            >
              {formatAmount(item.value)}
            </Typography>
            {showFull && (
              <Typography
                sx={{
                  fontFamily: theme.typography.fontFamily,
                  fontSize: 11,
                  opacity: 0.82,
                  mt: 0.25,
                }}
              >
                {item.share}% {shareLabel}
              </Typography>
            )}
          </Box>
        )}
      </Box>
    </Box>
  );
}

/** Color-dot + label legend row, wraps cleanly regardless of item count. */
function Legend({ items, colorFor }) {
  return (
    <Box
      sx={{
        mt: 2,
        display: "grid",
        gridTemplateColumns: "repeat(auto-fit, minmax(136px, 1fr))",
        rowGap: 0.85,
        columnGap: 1.5,
      }}
    >
      {items.map((l) => (
        <Stack key={l.name} direction="row" spacing={0.75} alignItems="center">
          <Box
            sx={{
              width: 8,
              height: 8,
              borderRadius: "2px",
              bgcolor: colorFor(l.name),
              flexShrink: 0,
            }}
          />
          <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }} noWrap>
            {l.name}
          </Typography>
        </Stack>
      ))}
    </Box>
  );
}

/**
 * Props:
 *  - config: { title, subtitle, items: {name, value, share, type}[], legend: {name}[],
 *              filterOptions?: string[], activeFilter?: string }
 *    Each item's `type` drives the filter dropdown below — `filterOptions[0]`
 *    is treated as "show everything"; any other option filters items down
 *    to `item.type === selectedOption`.
 *  - icon: MUI icon component for the panel header
 *  - gradientDark / gradientLight: hex strings, this section's gradient
 *    endpoints (e.g. dark teal→light mint for deposits, dark purple→light
 *    lavender for loans) — the largest item renders at gradientDark, the
 *    smallest at gradientLight.
 *  - shareLabel: string appended after each tile's percentage, e.g.
 *    "of deposits" / "of loans"
 *  - onTileClick: optional (item) => void. Tiles are display-only (just a
 *    hover lift) unless this is provided.
 *  - panelId / selectedPanel / onSelectPanel: optional click-to-highlight
 *    wiring, shared with every other panel (see GlassPanel in common.jsx).
 */
export default function HeatTree({
  config,
  icon = Inventory2RoundedIcon,
  gradientDark,
  gradientLight,
  shareLabel = "of total",
  onTileClick,
  panelId,
  selectedPanel,
  onSelectPanel,
}) {
  const hasFilter = Array.isArray(config.filterOptions) && config.filterOptions.length > 1;
  const [filter, setFilter] = useState(
    config.activeFilter || (hasFilter ? config.filterOptions[0] : undefined),
  );
  const showAll = !hasFilter || filter === config.filterOptions[0];

  const items = useMemo(() => {
    if (showAll) return config.items;
    return config.items.filter((it) => it.type === filter);
  }, [config.items, filter, showAll]);

  const legend = useMemo(() => {
    if (showAll) return config.legend;
    const names = new Set(items.map((it) => it.name));
    return config.legend.filter((l) => names.has(l.name));
  }, [config.legend, showAll, items]);

  // One fixed color per NAME (not sort position or render order), so a
  // category's shade never shifts between the treemap and the legend, or
  // when a filter/sort changes which item happens to render first.
  const colorForName = useMemo(() => {
    const values = items.map((it) => it.value);
    const minValue = values.length ? Math.min(...values) : 0;
    const maxValue = values.length ? Math.max(...values) : 0;

    const map = new Map(
      items.map((it) => [it.name, heatColor(it.value, minValue, maxValue, gradientDark, gradientLight)]),
    );
    return (name) => map.get(name) || gradientLight;
  }, [items, gradientDark, gradientLight]);

  // Largest → smallest so the biggest rectangle reliably lands in a
  // corner (matching the reference image's layout), and so the split
  // algorithm groups similarly-sized items together.
  const sortedItems = useMemo(() => [...items].sort((a, b) => b.value - a.value), [items]);

  const layout = useMemo(() => buildTreemap(sortedItems, 0, 0, 100, 100, true), [sortedItems]);

  return (
    <GlassPanel selected={selectedPanel === panelId} onClick={() => onSelectPanel?.(panelId)}>
      <PanelHeader
        icon={icon}
        title={config.title}
        action={
          hasFilter ? (
            <MiniSelect options={config.filterOptions} value={filter} onChange={setFilter} />
          ) : undefined
        }
      />
      {config.subtitle && (
        <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>
          {config.subtitle}
        </Typography>
      )}

      {/* Fixed-height frame the treemap fills exactly — overflow: hidden is
          a hard safety net so a tile can never visually spill past the
          card even in an edge case. */}
      <Box
        sx={{
          position: "relative",
          width: "100%",
          height: { xs: 220, sm: 250, md: 280 },
          overflow: "hidden",
        }}
      >
        {layout.map(({ item, x, y, w, h }) => (
          <Tile
            key={item.name}
            item={item}
            x={x}
            y={y}
            w={w}
            h={h}
            color={colorForName(item.name)}
            shareLabel={shareLabel}
            onClick={onTileClick ? () => onTileClick(item) : undefined}
          />
        ))}
      </Box>

      <Legend items={legend} colorFor={colorForName} />
    </GlassPanel>
  );
}













/* ---------------------------------------------------------------------- */
/*  Gauge.jsx                                                              */
/*  Semi-donut gauge with a value-driven needle, used for the CASA Ratio.  */
/*  Status bands are a fixed red/amber/green — a "traffic light" read      */
/*  rather than category colors — and the needle angle comes directly     */
/*  from `config.value`, so it always points exactly where the number      */
/*  says.                                                                  */
/*                                                                          */
/*  BAND THRESHOLDS — driven by the API when available. The API sends      */
/*  the band definitions as text (e.g. "Below 30%", "30% – 50%",           */
/*  "Above 50%") via mapApiToDashboardData's `casaGauge.bands` — parsed    */
/*  there into `{ low, high }`. If that's missing or fails validation      */
/*  here, this falls back to a sensible DEFAULT_BANDS split rather than    */
/*  breaking.                                                              */
/*                                                                          */
/*  GEOMETRY — no longer forced square. The previous version used one      */
/*  fixed VIEWBOX (300×300) for the needle's SVG overlay, matched to a     */
/*  square container. A semi-donut only occupies roughly the TOP half of   */
/*  a circle — in a square box that leaves a big empty gap above it, and   */
/*  that gap gets proportionally BIGGER the larger the square gets (this   */
/*  was the actual "too much space upward" bug — it wasn't fixable by      */
/*  resizing, the wasted space was baked into forcing width == height).    */
/*  Width and height are now independent (`GAUGE_WIDTH` / `GAUGE_HEIGHT`,  */
/*  a short wide box), and the needle's SVG viewBox now matches the real   */
/*  W×H instead of a fixed square — so it never gets stretched/misaligned  */
/*  relative to the Pie underneath it.                                    */
/*                                                                          */
/*  NEEDLE/TEXT OVERLAP — the needle's center dot sits at (cx, cy). The    */
/*  band's radii were checked against it before, but not the readout text  */
/*  below it — CY_PERCENT was pulled up from 0.86 to 0.7 so there's a      */
/*  solid gap between the needle's dot and where the "X.X%" text renders.  */
/*                                                                          */
/*  CARD WIDTH — narrowed by giving this card's masonry wrapper an         */
/*  explicit width (see DepositsLoansDashboard.jsx) instead of letting it  */
/*  fill its column like every other card. Correction from an earlier      */
/*  version of this comment: CSS multi-column does NOT force every item    */
/*  in a column to be exactly that column's width — a child can have a     */
/*  narrower explicit width and just sit centered/left-aligned with        */
/*  nothing else affected, which is exactly what's done here.             */
/* ---------------------------------------------------------------------- */

import React from "react";
import { Box, Stack, Typography } from "@mui/material";
import { useTheme } from "@mui/material/styles";
import { Cell, Pie, PieChart, ResponsiveContainer } from "recharts";
import PieChartRoundedIcon from "@mui/icons-material/PieChartRounded";
import { GlassPanel, PanelHeader, textSecondarySx } from "./common";

const DEFAULT_BANDS = { low: 35, high: 65 };

// Tune the gauge's footprint here. HEIGHT can now be much smaller than
// WIDTH — they're independent, unlike the old forced-square version.
const GAUGE_WIDTH = 180; // narrowed further per explicit request
const GAUGE_HEIGHT = 170;
const CX_PERCENT = 0.5; // matches the Pie's cx="50%"
const CY_PERCENT = 0.7; // FIX: pulled well up from 0.86 — at 0.86 the needle's center dot (y≈133 in a 155px box) sat directly inside the "14.0%" text's own vertical span (≈123-153), which is what was actually overlapping — not the band. This leaves ~50px of clear space below the needle for the text.
const OUTER_RADIUS = 82; // must be <= GAUGE_WIDTH * CX_PERCENT or it clips left/right
const INNER_RADIUS = 58;
const NEEDLE_LENGTH = 42; // clear ~16px gap from INNER_RADIUS

/** Validates an API-derived `{ low, high }` pair before trusting it —
 * both must be finite numbers, in range, and low strictly less than high.
 * Falls back to DEFAULT_BANDS for anything else (missing, malformed, or
 * nonsensical, e.g. low >= high). */
function resolveBands(bands) {
  if (
    bands &&
    typeof bands.low === "number" &&
    typeof bands.high === "number" &&
    Number.isFinite(bands.low) &&
    Number.isFinite(bands.high) &&
    bands.low >= 0 &&
    bands.high <= 100 &&
    bands.low < bands.high
  ) {
    return bands;
  }
  return DEFAULT_BANDS;
}

function statusFor(value, bands) {
  if (value < bands.low) return "low";
  if (value <= bands.high) return "mid";
  return "high";
}

/**
 * Props:
 *  - config: { title, subtitle, value, centerLabel, bands?: { low, high } }
 *  - panelId / selectedPanel / onSelectPanel: optional click-to-highlight
 *    wiring, shared with every other panel (see GlassPanel in common.jsx).
 */
export default function Gauge({ config, panelId, selectedPanel, onSelectPanel }) {
  const theme = useTheme();
  const RADIAN = Math.PI / 180;
  const cx = GAUGE_WIDTH * CX_PERCENT;
  const cy = GAUGE_HEIGHT * CY_PERCENT;

  const bands = resolveBands(config.bands);
  const statusBands = [
    { name: `Below ${bands.low}%`, width: 33.3, key: "low" },
    { name: `${bands.low}% – ${bands.high}%`, width: 33.3, key: "mid" },
    { name: `Above ${bands.high}%`, width: 33.3, key: "high" },
  ];

  // The API can return casaGauge.value as null (not populated yet). Render
  // an explicit "not available" state instead of NaN math / a broken needle.
  const hasValue = typeof config.value === "number" && Number.isFinite(config.value);

  const statusColor = {
    low: theme.palette.error.main,
    mid: theme.palette.warning.main,
    high: theme.palette.success.main,
  };
  const bandData = statusBands.map((b) => ({ name: b.name, value: b.width }));
  const currentStatus = hasValue ? statusFor(config.value, bands) : null;
  const needleColor = hasValue ? statusColor[currentStatus] : theme.palette.text.disabled;

  const clampedValue = hasValue ? Math.min(Math.max(config.value, 0), 100) : 0;
  const needleAngle = 180 - (clampedValue / 100) * 180; // 0..180 -> deg, driven by the actual value

  return (
    <GlassPanel sx={{ p: 2.5 }} selected={selectedPanel === panelId} onClick={() => onSelectPanel?.(panelId)}>
      <PanelHeader icon={PieChartRoundedIcon} title={config.title} />

      <Box
        sx={{
          position: "relative",
          width: GAUGE_WIDTH,
          height: GAUGE_HEIGHT,
          maxWidth: "100%",
          mx: "auto",
          mb: 0.5,
          "& svg:focus, & svg *:focus": { outline: "none" },
        }}
      >
        <ResponsiveContainer>
          <PieChart>
            <Pie
              data={bandData}
              dataKey="value"
              nameKey="name"
              cx={`${CX_PERCENT * 100}%`}
              cy={`${CY_PERCENT * 100}%`}
              startAngle={180}
              endAngle={0}
              innerRadius={INNER_RADIUS}
              outerRadius={OUTER_RADIUS}
              cornerRadius={4}
              stroke="none"
              isAnimationActive={false}
            >
              <Cell fill={statusColor.low} opacity={hasValue ? 1 : 0.35} />
              <Cell fill={statusColor.mid} opacity={hasValue ? 1 : 0.35} />
              <Cell fill={statusColor.high} opacity={hasValue ? 1 : 0.35} />
            </Pie>
          </PieChart>
        </ResponsiveContainer>

        {/* needle + center readout, overlaid absolutely. viewBox now
            matches the container's real W×H (not a fixed square), so
            cx/cy line up with the Pie's actual center regardless of
            aspect ratio — no stretch, no misalignment. */}
        {hasValue && (
          <Box sx={{ position: "absolute", inset: 0, pointerEvents: "none" }}>
            <svg viewBox={`0 0 ${GAUGE_WIDTH} ${GAUGE_HEIGHT}`} width="100%" height="100%" preserveAspectRatio="none">
              <circle cx={cx} cy={cy} r="6" fill={needleColor} />
              <line
                x1={cx}
                y1={cy}
                x2={cx + NEEDLE_LENGTH * Math.cos(needleAngle * RADIAN)}
                y2={cy - NEEDLE_LENGTH * Math.sin(needleAngle * RADIAN)}
                stroke={needleColor}
                strokeWidth="4"
                strokeLinecap="round"
              />
            </svg>
          </Box>
        )}

        <Box sx={{ position: "absolute", left: 0, right: 0, bottom: 2, textAlign: "center" }}>
          <Typography sx={{ fontSize: 26, fontWeight: 700, lineHeight: 1, color: needleColor }}>
            {hasValue ? `${config.value.toFixed(1)}%` : "—"}
          </Typography>
          {!hasValue && (
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500, mt: 0.5 }}>
              Not available yet
            </Typography>
          )}
        </Box>
      </Box>

      <Stack direction="row" spacing={2} justifyContent="center" flexWrap="wrap" sx={{ mt: 1 }}>
        {statusBands.map((b) => (
          <Stack key={b.key} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "50%", bgcolor: statusColor[b.key] }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }}>{b.name}</Typography>
          </Stack>
        ))}
      </Stack>
    </GlassPanel>
  );
}














