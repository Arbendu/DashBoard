/*  DepositsLoansDashboard.jsx — root component                            */
/*  Purely presentational/compositional. Every number on screen comes      */
/*  from the `data` prop. Nothing is imported or hardcoded here for the    */
/*  treemaps/gauge — see DashboardPage.jsx for how the real API's          */
/*  response gets mapped into this shape (mapApiToDashboardData.js).       */
/*                                                                          */
/*  Loans section restored — the API now returns a `loans` object. Its     */
/*  single item list drives both the composition treemap and the          */
/*  breakdown bar panel below, the same way Deposits does with two         */
/*  separate demand/time lists.                                           */
/*                                                                          */
/*  DEMAND/TIME DEPOSITS — per request, these two are now TrendBubbleChart */
/*  (view-only bubble/scatter, no click interaction), replacing            */
/*  DateWiseBarPanel in these two slots specifically.                     */
/*                                                                          */
/*  LOAN DISTRIBUTION — still DateWiseBarPanel (multi-date, drill-         */
/*  downable, bar/biaxial-line toggle), unchanged.                        */
/*                                                                          */
/*  NEW — Total Deposits Trend (3-level drill: composed chart -> Demand/   */
/*  Time 7-day overview -> single-day breakdown; see                       */
/*  TotalDepositsTrendPanel.jsx) and CASA Trend (view-only filled area      */
/*  chart; see CasaTrendChart.jsx), added as a new row below.              */
/*                                                                          */
/*  All trend data comes from the `trendSections` prop — the real          */
/*  /DS/dashboard/trend-data response, mapped by trendApi.js.             */
/* ---------------------------------------------------------------------- */

import React, { useState } from "react";
import { Box, Stack, Typography } from "@mui/material";
import AccountBalanceRoundedIcon from "@mui/icons-material/AccountBalanceRounded";
import AccountBalanceWalletRoundedIcon from "@mui/icons-material/AccountBalanceWalletRounded";
import DescriptionRoundedIcon from "@mui/icons-material/DescriptionRounded";
import TrendingUpRoundedIcon from "@mui/icons-material/TrendingUpRounded";
import ShowChartRoundedIcon from "@mui/icons-material/ShowChartRounded";
import PieChartRoundedIcon from "@mui/icons-material/PieChartRounded";
import { textPrimarySx, textSecondarySx } from "./common";
import HeatTree from "./HeatTree";
import Gauge from "./Gauge";
import DateWiseBarPanel from "./DateWiseBarPanel";
import TrendBubbleChart from "./TrendBubbleChart";
import TotalDepositsTrendPanel from "./TotalDepositsTrendPanel";
import CasaTrendChart from "./CasaTrendChart";

/** Page title/subtitle. Only used once, kept inline rather than as its
 * own file. */
function DashboardHeader({ config }) {
  return (
    <Stack
      direction={{ xs: "column", lg: "row" }}
      alignItems={{ xs: "flex-start", lg: "center" }}
      justifyContent="space-between"
      spacing={2}
      sx={{ px: 0.5 }}
    >
      <Box>
        <Typography
          sx={{
            ...textPrimarySx,
            fontSize: { xs: 20, md: 24 },
            fontWeight: 700,
          }}
        >
          {config.title}
        </Typography>
        {config.subtitle && (
          <Typography sx={{ ...textSecondarySx, fontSize: 13, mt: 0.25 }}>
            {config.subtitle}
          </Typography>
        )}
      </Box>
    </Stack>
  );
}

/** Looks up one trend section by its `key` from the trendSections prop —
 * same lookup pattern as before, just reading from a prop (the real API
 * response) instead of an imported mock file. */
function trendSection(trendSections, key) {
  return trendSections?.find((s) => s.key === key);
}

/**
 * Props:
 *  - data: {
 *      header: { title, subtitle },
 *      casaGauge: { title, subtitle, value: number | null, centerLabel, bands?: { low, high } },
 *      depositsComposition: {
 *        title, subtitle,
 *        items: { name, value, share, type }[],
 *        legend: { name }[],
 *        filterOptions?: string[], activeFilter?: string,
 *      },
 *      loansComposition: { title, subtitle, items, legend, filterOptions?, activeFilter? },
 *    }
 *    (demandDeposits/termDeposits/loansBreakdown are not read from `data`
 *    — see `trendSections` below.)
 *  - trendSections: { key, title, products, data }[] — from
 *    /DS/dashboard/trend-data via trendApi.js's mapTrendDataToSections().
 *    Looked up by `key` for each of the three DateWiseBarPanel calls below.
 */
export default function DepositsLoansDashboard({ data, trendSections }) {
  const [selectedPanel, setSelectedPanel] = useState(null);

  if (!data) return null;

  return (
    <Box
      sx={{
        display: "flex",
