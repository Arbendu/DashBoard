
























/**
 * dataProvider.js — data access layer.
 *
 * Reusable chart/card components never import mockdata.json directly and
 * never know whether their data came from a static file or a network call.
 * They only call the functions exported here. When the backend is ready,
 * replace the bodies below with real `fetch`/axios calls (keeping the same
 * function names and return shapes) and no other file needs to change.
 */

import dashboardData from "./mockdata.json";

/**
 * Fetch the full dashboard payload (header, gauge, composition + bar chart
 * configs). Returns a Promise so callers don't need to change when this
 * becomes a real network request.
 */
export function fetchDashboardData() {
  return Promise.resolve(dashboardData);
}

/**
 * Fetch drill-down data for a single chart item (e.g. "Term Deposit",
 * "Term Loan"). Looks the item up in the shared `drilldowns` map, which is
 * keyed by item name so the same entry can be reused by both the
 * composition mosaic tiles and the bar charts.
 *
 * Returns a Promise<{ title, subtitle, data } | null> — `null` means no
 * drill-down is available for that item, and callers should leave the
 * current view as-is.
 *
 * Example future replacement:
 *   export function fetchDrilldown(itemName) {
 *     return fetch(`/api/dashboard/drilldown?item=${encodeURIComponent(itemName)}`)
 *       .then((res) => (res.ok ? res.json() : null));
 *   }
 */
export function fetchDrilldown(itemName) {
  const entry = dashboardData.drilldowns?.[itemName] ?? null;
  return Promise.resolve(entry);
}



















