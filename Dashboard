/* ---------------------------------------------------------------------- */
/*  mapApiToDashboardData.js                                               */
/*  Translates ONE `staticDashboardData[i]` section from the real API      */
/*  response into the exact shape <DepositsLoansDashboard data={...} />    */
/*  expects. This is the ONLY place that needs to change if the API        */
/*  response shape changes — no component touches the raw API shape.       */
/*                                                                          */
/*  Values NOT present in the API are calculated here, never hardcoded:    */
/*   - `share` (% of total) per deposit/loan item                         */
/*   - `topValue` (largest category, formatted) per bar panel             */
/*                                                                          */
/*  SECURITY / ROBUSTNESS NOTE — this is the one file that touches raw,    */
/*  untrusted network data before anything else sees it. Every field is    */
/*  read defensively (type-checked, range-clamped, array-guarded) so a     */
/*  malformed, partial, or unexpected API response can never throw and     */
/*  crash the dashboard — worst case, a value falls back to a safe         */
/*  default ("not available", 0, or an empty list) and the rest of the     */
/*  page still renders. The whole export is wrapped in try/catch for the   */
/*  same reason. All values are plain numbers/strings passed through       */
/*  React's normal text rendering — nothing here is ever put into HTML     */
/*  directly, so there's no injection surface from this data.             */
/* ---------------------------------------------------------------------- */

import { formatAmount, normalizeDepositName } from "./utils";

/** Coerces `raw` into a finite, non-negative number, or `0` if it can't
 * be trusted (missing, wrong type, NaN, negative). Deposit/loan amounts
 * are never legitimately negative, and a stray negative or NaN value
 * would otherwise corrupt every downstream calculation that depends on
 * it (shares, totals, sqrt-based tile sizing in HeatTree). */
function toSafeAmount(raw) {
  const n = Number(raw);
  return Number.isFinite(n) && n >= 0 ? n : 0;
}

function mapItems(rawItems) {
  if (!Array.isArray(rawItems)) return [];
  return rawItems
    .filter((it) => it && typeof it === "object")
    .map((it) => ({
      name: normalizeDepositName(it.name),
      type: String(it.type || "").trim(),
      value: toSafeAmount(it.value),
    }));
}

/** Adds a `share` (% of the group's total, one decimal place) to each item —
 * not provided by the API, calculated here. */
function withShare(items) {
  const total = items.reduce((sum, it) => sum + it.value, 0);
  return items.map((it) => ({
    ...it,
    share: total > 0 ? Number(((it.value / total) * 100).toFixed(1)) : 0,
  }));
}

/** "Largest category" summary line shown on the bar panels — not provided
 * by the API, calculated here from whatever data came back. */
function topValueOf(items) {
  if (!items.length) return undefined;
  return formatAmount(Math.max(...items.map((it) => it.value)));
}

/** Builds the { title, topValue, items/data } shape shared by every
 * composition (treemap) + breakdown (bar) section, so deposits/loans
 * don't each repeat the same handful of lines. */
function buildSection(raw) {
  const items = withShare(mapItems(raw?.data));
  return {
    title: typeof raw?.title === "string" ? raw.title : "",
    subtitle: typeof raw?.subtitle === "string" ? raw.subtitle : undefined,
    filterOptions: Array.isArray(raw?.filterOptions) ? raw.filterOptions.filter((o) => typeof o === "string") : undefined,
    activeFilter: Array.isArray(raw?.filterOptions) ? raw.filterOptions[0] : undefined,
    items,
    legend: items.map((it) => ({ name: it.name })),
    topValue: topValueOf(items),
    data: items, // same list, shaped for a bar panel's `data` prop
  };
}

/* ---- CASA ratio -----------------------------------------------------------
 * The API sends casaratio.value as a plain fraction (e.g. 0.140 = 14.0%).
 * Guarded rather than assumed: if a future response sends an already-
 * converted percentage (e.g. 14.0) instead, that's still handled; anything
 * outside a sane range is treated as "not available" rather than trusted
 * and displayed wrong. */

function normalizeCasaPercent(rawValue) {
  if (typeof rawValue !== "number" || !Number.isFinite(rawValue)) return null;
  if (rawValue >= 0 && rawValue <= 1) return rawValue * 100; // fraction, e.g. 0.14 -> 14%
  if (rawValue > 1 && rawValue <= 100) return rawValue; // already a percentage
  return null; // out of any sane range — don't guess, show "not available"
}

/** The API also sends the gauge's band definitions as text
 * (e.g. casaValue: "Below 30%", "30% – 50%", "Above 50%") instead of
 * hardcoded thresholds. Pulls the numbers out of that text so Gauge.jsx's
 * low/mid/high bands always match whatever the API actually says, instead
 * of a fixed 35/65 split. Returns null (Gauge falls back to its own
 * default) if the text can't be parsed — never throws on unexpected text. */
function parseCasaBandThresholds(bands) {
  if (!Array.isArray(bands) || bands.length === 0) return null;
  const numbers = bands
    .flatMap((b) => String(b?.casaValue || "").match(/\d+(\.\d+)?/g) || [])
    .map(Number)
    .filter((n) => Number.isFinite(n))
    .sort((a, b) => a - b);
  if (numbers.length < 2) return null;
  return { low: numbers[0], high: numbers[numbers.length - 1] };
}

/**
 * @param {object} section — one entry from `response.data.staticDashboardData`
 * @returns the `data` prop shape DepositsLoansDashboard expects, or null if
 *          `section` is missing/malformed beyond use.
 */
export default function mapApiToDashboardData(section) {
  try {
    if (!section || typeof section !== "object") return null;

    const depositsRaw = section.deposits;
    const demandRaw = section.demanddeposits;
    const timeRaw = section.timedeposits;
    const casaRaw = section.casaratio;
    const loansRaw = section.loans;

    const deposits = buildSection(depositsRaw);
    const demand = buildSection(demandRaw);
    const time = buildSection(timeRaw);
    const loans = buildSection(loansRaw);

    const casaPercent = normalizeCasaPercent(casaRaw?.value);
    const casaBands = parseCasaBandThresholds(casaRaw?.data);

    return {
      // Not present in the API — static page copy, not a business figure,
      // so this is the one place left as plain text rather than derived
      // data.
      header: {
        title: "Deposits Dashboard",
        subtitle: "Portfolio overview by category",
      },

      casaGauge: {
        title: typeof casaRaw?.title === "string" ? casaRaw.title : "CASA Ratio",
        subtitle: typeof casaRaw?.subtitle === "string" ? casaRaw.subtitle : undefined,
        // null whenever the value is missing/unparseable — Gauge.jsx
        // renders an explicit "not available yet" state for that case,
        // it never guesses or shows a misleading 0%.
        value: casaPercent,
        centerLabel: typeof casaRaw?.title === "string" ? casaRaw.title : "CASA Ratio",
        // Optional — Gauge.jsx falls back to its own default thresholds
        // if this is null (couldn't be parsed from the API's band text).
        bands: casaBands,
      },

      depositsComposition: {
        title: deposits.title,
        subtitle: deposits.subtitle,
        filterOptions: deposits.filterOptions,
        activeFilter: deposits.activeFilter,
        items: deposits.items,
        legend: deposits.legend,
      },

      demandDeposits: {
        title: demand.title,
        topValue: demand.topValue,
        data: demand.data,
      },

      termDeposits: {
        title: time.title,
        topValue: time.topValue,
        data: time.data,
      },

      loansComposition: {
        title: loans.title,
        subtitle: loans.subtitle,
        filterOptions: loans.filterOptions,
        activeFilter: loans.activeFilter,
        items: loans.items,
        legend: loans.legend,
      },

      loansBreakdown: {
        title: loans.title,
        topValue: loans.topValue,
        data: loans.data,
      },
    };
  } catch (err) {
    // Never let a malformed API response crash the dashboard — log for
    // observability and let the caller's existing "no data available"
    // state handle it gracefully.
    // eslint-disable-next-line no-console
    console.error("mapApiToDashboardData: failed to parse API response", err);
    return null;
  }
}














/* ---------------------------------------------------------------------- */
/*  Gauge.jsx                                                              */
/*  Semi-donut gauge with a value-driven needle, used for the CASA Ratio.  */
/*  Status bands are a fixed red/amber/green — a "traffic light" read      */
/*  rather than category colors — and the needle angle comes directly     */
/*  from `config.value`, so it always points exactly where the number      */
/*  says.                                                                  */
/*                                                                          */
/*  BAND THRESHOLDS — now driven by the API when available. The API sends  */
/*  the band definitions as text (e.g. "Below 30%", "30% – 50%",           */
/*  "Above 50%") via mapApiToDashboardData's `casaGauge.bands` — parsed    */
/*  there into `{ low, high }`. If that's missing or fails validation      */
/*  here, this falls back to a sensible DEFAULT_BANDS split rather than    */
/*  breaking, so a malformed/missing API field never crashes the gauge.    */
/*                                                                          */
/*  The gauge box is a fixed SQUARE on purpose: the needle is a plain SVG  */
/*  overlay using a 300×300 coordinate system, which only lines up with    */
/*  the Pie underneath it when the container is square.                   */
/* ---------------------------------------------------------------------- */

import React from "react";
import { Box, Stack, Typography } from "@mui/material";
import { useTheme } from "@mui/material/styles";
import { Cell, Pie, PieChart, ResponsiveContainer } from "recharts";
import PieChartRoundedIcon from "@mui/icons-material/PieChartRounded";
import { GlassPanel, PanelHeader, textSecondarySx } from "./common";

const DEFAULT_BANDS = { low: 35, high: 65 };

/** Validates an API-derived `{ low, high }` pair before trusting it —
 * both must be finite numbers, in range, and low strictly less than high.
 * Falls back to DEFAULT_BANDS for anything else (missing, malformed, or
 * nonsensical, e.g. low >= high). */
function resolveBands(bands) {
  if (
    bands &&
    typeof bands.low === "number" &&
    typeof bands.high === "number" &&
    Number.isFinite(bands.low) &&
    Number.isFinite(bands.high) &&
    bands.low >= 0 &&
    bands.high <= 100 &&
    bands.low < bands.high
  ) {
    return bands;
  }
  return DEFAULT_BANDS;
}

function statusFor(value, bands) {
  if (value < bands.low) return "low";
  if (value <= bands.high) return "mid";
  return "high";
}

/**
 * Props:
 *  - config: { title, subtitle, value, centerLabel, bands?: { low, high } }
 *  - panelId / selectedPanel / onSelectPanel: optional click-to-highlight
 *    wiring, shared with every other panel (see GlassPanel in common.jsx).
 */
export default function Gauge({ config, panelId, selectedPanel, onSelectPanel }) {
  const theme = useTheme();
  const RADIAN = Math.PI / 180;
  const VIEWBOX = 300;
  const cx = VIEWBOX * 0.5; // matches the Pie's cx="50%"
  const cy = VIEWBOX * 0.85; // matches the Pie's cy="85%" — NOT cx/cy * 0.85
  const innerR = 95;
  const GAUGE_SIZE = 280; // fixed + square — see note above

  const bands = resolveBands(config.bands);
  const statusBands = [
    { name: `Below ${bands.low}%`, width: 33.3, key: "low" },
    { name: `${bands.low}% – ${bands.high}%`, width: 33.3, key: "mid" },
    { name: `Above ${bands.high}%`, width: 33.3, key: "high" },
  ];

  // The API can return casaGauge.value as null (not populated yet). Render
  // an explicit "not available" state instead of NaN math / a broken needle.
  const hasValue = typeof config.value === "number" && Number.isFinite(config.value);

  const statusColor = {
    low: theme.palette.error.main,
    mid: theme.palette.warning.main,
    high: theme.palette.success.main,
  };
  const bandData = statusBands.map((b) => ({ name: b.name, value: b.width }));
  const currentStatus = hasValue ? statusFor(config.value, bands) : null;
  const needleColor = hasValue ? statusColor[currentStatus] : theme.palette.text.disabled;

  const clampedValue = hasValue ? Math.min(Math.max(config.value, 0), 100) : 0;
  const needleAngle = 180 - (clampedValue / 100) * 180; // 0..180 -> deg, driven by the actual value

  return (
    <GlassPanel sx={{ p: 3 }} selected={selectedPanel === panelId} onClick={() => onSelectPanel?.(panelId)}>
      <PanelHeader icon={PieChartRoundedIcon} title={config.title} />

      <Box
        sx={{
          position: "relative",
          width: GAUGE_SIZE,
          height: GAUGE_SIZE,
          mx: "auto",
          mb: 1,
          "& svg:focus, & svg *:focus": { outline: "none" },
        }}
      >
        <ResponsiveContainer>
          <PieChart>
            <Pie
              data={bandData}
              dataKey="value"
              nameKey="name"
              cx="50%"
              cy="85%"
              startAngle={180}
              endAngle={0}
              innerRadius={92}
              outerRadius={130}
              cornerRadius={4}
              stroke="none"
              isAnimationActive={false}
            >
              <Cell fill={statusColor.low} opacity={hasValue ? 1 : 0.35} />
              <Cell fill={statusColor.mid} opacity={hasValue ? 1 : 0.35} />
              <Cell fill={statusColor.high} opacity={hasValue ? 1 : 0.35} />
            </Pie>
          </PieChart>
        </ResponsiveContainer>

        {/* needle + center readout, overlaid absolutely — cx/cy match the
            Pie's actual cx="50%" cy="85%" exactly, so the needle's base
            sits right at the pie center instead of drifting off it.
            No needle at all when there's no value to point to. */}
        {hasValue && (
          <Box sx={{ position: "absolute", inset: 0, pointerEvents: "none" }}>
            <svg viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`} width="100%" height="100%">
              <circle cx={cx} cy={cy} r="7" fill={needleColor} />
              <line
                x1={cx}
                y1={cy}
                x2={cx + (innerR - 6) * Math.cos(needleAngle * RADIAN)}
                y2={cy - (innerR - 6) * Math.sin(needleAngle * RADIAN)}
                stroke={needleColor}
                strokeWidth="4"
                strokeLinecap="round"
              />
            </svg>
          </Box>
        )}

        <Box sx={{ position: "absolute", left: 0, right: 0, bottom: 6, textAlign: "center" }}>
          <Typography sx={{ fontSize: 30, fontWeight: 700, lineHeight: 1, color: needleColor }}>
            {hasValue ? `${config.value.toFixed(1)}%` : "—"}
          </Typography>
          {!hasValue && (
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500, mt: 0.5 }}>
              Not available yet
            </Typography>
          )}
        </Box>
      </Box>

      <Stack direction="row" spacing={2.5} justifyContent="center" flexWrap="wrap" sx={{ mt: 1.5 }}>
        {statusBands.map((b) => (
          <Stack key={b.key} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "50%", bgcolor: statusColor[b.key] }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }}>{b.name}</Typography>
          </Stack>
        ))}
      </Stack>
    </GlassPanel>
  );
}
















/* ---------------------------------------------------------------------- */
/*  DepositsLoansDashboard.jsx — root component                            */
/*  Purely presentational/compositional. Every number on screen comes      */
/*  from the `data` prop, every drill-down from `fetchDrilldown`. Nothing  */
