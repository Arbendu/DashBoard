import React, { useState } from "react";
import {
  Box,
  Paper,
  Stack,
  Typography,
  Select,
  MenuItem,
  Button,
  Chip,
} from "@mui/material";
import { createTheme, ThemeProvider, alpha } from "@mui/material/styles";
import RefreshRoundedIcon from "@mui/icons-material/RefreshRounded";
import CalendarTodayRoundedIcon from "@mui/icons-material/CalendarTodayRounded";
import AccountBalanceRoundedIcon from "@mui/icons-material/AccountBalanceRounded";
import DescriptionRoundedIcon from "@mui/icons-material/DescriptionRounded";
import PieChartRoundedIcon from "@mui/icons-material/PieChartRounded";
import Inventory2RoundedIcon from "@mui/icons-material/Inventory2Rounded";
import AccountBalanceWalletRoundedIcon from "@mui/icons-material/AccountBalanceWalletRounded";
import EqualizerRoundedIcon from "@mui/icons-material/EqualizerRounded";

import {
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  PieChart,
  Pie,
  Cell,
  LabelList,
} from "recharts";

import dashboardData from "./mockdata.json";

/* ---------------------------------------------------------------------- */
/*  Theme                                                                  */
/* ---------------------------------------------------------------------- */

const theme = createTheme({
  palette: {
    mode: "light",
    primary: { main: "#6C5CE0", dark: "#5847C9", light: "#8B7CF6" },
    background: { default: "transparent", paper: "#FFFFFF" },
    text: { primary: "#1E1B3A", secondary: "#6B6584" },
  },
  shape: { borderRadius: 20 },
  typography: {
    fontFamily: [
      "Inter",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "Roboto",
      "Helvetica",
      "Arial",
      "sans-serif",
    ].join(","),
  },
});

/* ---------------------------------------------------------------------- */
/*  Small building blocks                                                  */
/* ---------------------------------------------------------------------- */

function PanelHeader({ icon: Icon, title, action, iconColor = "#6C5CE0" }) {
  return (
    <Stack direction="row" alignItems="center" justifyContent="space-between" sx={{ mb: 2 }}>
      <Stack direction="row" alignItems="center" spacing={1.25}>
        {Icon && (
          <Box
            sx={{
              width: 34,
              height: 34,
              borderRadius: "10px",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              bgcolor: alpha(iconColor, 0.12),
              color: iconColor,
            }}
          >
            <Icon sx={{ fontSize: 19 }} />
          </Box>
        )}
        <Typography sx={{ fontWeight: 800, fontSize: 15, letterSpacing: 0.2, color: "text.primary" }}>
          {title}
        </Typography>
      </Stack>
      {action}
    </Stack>
  );
}

function MiniSelect({ options, value, onChange }) {
  return (
    <Select
      size="small"
      value={value}
      onChange={(e) => onChange(e.target.value)}
      sx={{
        fontSize: 13,
        fontWeight: 600,
        borderRadius: "10px",
        bgcolor: "#F7F5FC",
        "& .MuiOutlinedInput-notchedOutline": { border: "1px solid #E7E2F7" },
        "& .MuiSelect-select": { py: 0.75, pr: 4 },
      }}
    >
      {options.map((opt) => (
        <MenuItem key={opt} value={opt} sx={{ fontSize: 13 }}>
          {opt}
        </MenuItem>
      ))}
    </Select>
  );
}

function SectionTitle({ children }) {
  return (
    <Typography
      sx={{
        fontSize: { xs: 17, md: 19 },
        fontWeight: 800,
        color: "#1E1B3A",
        mb: 1.75,
        mt: 0.5,
        pl: 0.5,
        borderLeft: "4px solid #6C5CE0",
        lineHeight: 1.4,
      }}
    >
      &nbsp;{children}
    </Typography>
  );
}

/* ---------------------------------------------------------------------- */
/*  CASA Gauge (semi-donut + needle) built with Recharts Pie               */
/* ---------------------------------------------------------------------- */

function Gauge({ config }) {
  const RADIAN = Math.PI / 180;
  const cx = 150;
  const cy = 150;
  const innerR = 92;

  const needleAngle = 180 - (config.needlePercent / 100) * 180; // 0..180 -> deg

  return (
    <Paper elevation={0} sx={{ p: 2.5, borderRadius: "20px", border: "1px solid #ECE6FA", height: "100%" }}>
      <PanelHeader icon={PieChartRoundedIcon} title={config.title} />
      <Typography sx={{ fontSize: 12.5, color: "text.secondary", mt: -1.5, mb: 1 }}>
        {config.subtitle}
      </Typography>

      <Box sx={{ position: "relative", width: "100%", height: 210 }}>
        <ResponsiveContainer>
          <PieChart>
            <Pie
              data={config.segments}
              dataKey="value"
              nameKey="name"
              cx="50%"
              cy="85%"
              startAngle={180}
              endAngle={0}
              innerRadius={92}
              outerRadius={130}
              paddingAngle={2}
              stroke="none"
              isAnimationActive={false}
            >
              {config.segments.map((s, i) => (
                <Cell key={i} fill={s.color} />
              ))}
            </Pie>
          </PieChart>
        </ResponsiveContainer>

        {/* needle + center readout, overlaid absolutely */}
        <Box sx={{ position: "absolute", inset: 0, pointerEvents: "none" }}>
          <svg viewBox="0 0 300 300" width="100%" height="100%">
            <circle cx={cx} cy={cy * 0.85 + 0} r="7" fill="#2A1E5C" />
            <line
              x1={cx}
              y1={cy * 0.85}
              x2={cx + (innerR - 6) * Math.cos(needleAngle * RADIAN)}
              y2={cy * 0.85 - (innerR - 6) * Math.sin(needleAngle * RADIAN)}
              stroke="#2A1E5C"
              strokeWidth="4"
              strokeLinecap="round"
            />
          </svg>
        </Box>

        <Box
          sx={{
            position: "absolute",
            left: 0,
            right: 0,
            bottom: 6,
            textAlign: "center",
          }}
        >
          <Typography sx={{ fontSize: 30, fontWeight: 800, color: "#1E1B3A", lineHeight: 1.1 }}>
            {config.value.toFixed(1)}%
          </Typography>
          <Typography sx={{ fontSize: 13, color: "text.secondary", fontWeight: 600 }}>
            {config.centerLabel}
          </Typography>
        </Box>
      </Box>

      <Stack direction="row" spacing={2.5} justifyContent="center" flexWrap="wrap" sx={{ mt: 1 }}>
        {config.segments.map((s) => (
          <Stack key={s.name} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 9, height: 9, borderRadius: "50%", bgcolor: s.color }} />
            <Typography sx={{ fontSize: 12, color: "text.secondary", fontWeight: 600 }}>
              {s.name}
            </Typography>
          </Stack>
        ))}
      </Stack>
    </Paper>
  );
}

/* ---------------------------------------------------------------------- */
/*  Composition mosaic (used for both Deposits and Loans)                  */
/*  Shows every category — proportional flex-basis tiles, à la treemap     */
/* ---------------------------------------------------------------------- */

function CompositionMosaic({ config, icon = Inventory2RoundedIcon }) {
  const hasFilter = Array.isArray(config.filterOptions) && config.filterOptions.length > 0;
  const [filter, setFilter] = useState(config.activeFilter || (hasFilter ? config.filterOptions[0] : undefined));
  const items = config.items;
  // proportional flex-basis mosaic, biggest three on top row, remaining stacked below
  const [big1, big2, big3, ...rest] = items;

  const Tile = ({ item, sx }) => (
    <Box
      sx={{
        borderRadius: "14px",
        p: 1.5,
        display: "flex",
        flexDirection: "column",
        justifyContent: "space-between",
        bgcolor: item.color,
        color: "#fff",
        minHeight: 70,
        ...sx,
      }}
    >
      <Typography sx={{ fontSize: 12.5, fontWeight: 700, opacity: 0.95, lineHeight: 1.2 }}>
        {item.name}
      </Typography>
      <Box>
        <Typography sx={{ fontSize: 16, fontWeight: 800 }}>₹ {item.value.toFixed(2)} T</Typography>
        <Typography sx={{ fontSize: 11, opacity: 0.9 }}>{item.share}%</Typography>
      </Box>
    </Box>
  );

  return (
    <Paper elevation={0} sx={{ p: 2.5, borderRadius: "20px", border: "1px solid #ECE6FA", height: "100%" }}>
      <PanelHeader
        icon={icon}
        title={config.title}
        action={
          hasFilter ? (
            <MiniSelect options={config.filterOptions} value={filter} onChange={setFilter} />
          ) : undefined
        }
      />
      <Typography sx={{ fontSize: 12.5, color: "text.secondary", mt: -1.5, mb: 1.5 }}>
        {config.subtitle}
      </Typography>

      <Box sx={{ display: "flex", gap: 1, height: 190 }}>
        <Tile item={big1} sx={{ flex: 1.3 }} />
        <Tile item={big2} sx={{ flex: 1.1 }} />
        <Box sx={{ flex: 1, display: "flex", flexDirection: "column", gap: 1 }}>
          <Tile item={big3} sx={{ flex: 1 }} />
          <Box sx={{ display: "flex", gap: 1, flex: 1 }}>
            {rest.map((r) => (
              <Tile key={r.name} item={r} sx={{ flex: 1, "& .MuiTypography-root": { fontSize: 10.5 } }} />
            ))}
          </Box>
        </Box>
      </Box>

      <Box
        sx={{
          mt: 2,
          display: "grid",
          gridTemplateColumns: "1fr 1fr",
          rowGap: 0.75,
          columnGap: 2,
        }}
      >
        {config.legend.map((l) => (
          <Stack key={l.name} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 9, height: 9, borderRadius: "3px", bgcolor: l.color, flexShrink: 0 }} />
            <Typography sx={{ fontSize: 11.5, color: "text.secondary", fontWeight: 600 }}>
              {l.name}
            </Typography>
          </Stack>
        ))}
      </Box>
    </Paper>
  );
}

/* ---------------------------------------------------------------------- */
/*  Bar chart panels (Demand / Term deposits, Loans breakdown)             */
/* ---------------------------------------------------------------------- */

function BarPanel({ icon, config }) {
  const hasDropdown = Array.isArray(config.dropdownOptions) && config.dropdownOptions.length > 0;
  const [option, setOption] = useState(config.activeOption || (hasDropdown ? config.dropdownOptions[0] : undefined));
  const longLabels = config.data.length > 5;

  return (
    <Paper elevation={0} sx={{ p: 2.5, borderRadius: "20px", border: "1px solid #ECE6FA", height: "100%" }}>
      <PanelHeader
        icon={icon}
        title={config.title}
        action={
          hasDropdown ? (
            <MiniSelect options={config.dropdownOptions} value={option} onChange={setOption} />
          ) : undefined
        }
      />
      <Box sx={{ width: "100%", height: longLabels ? 300 : 260 }}>
        <ResponsiveContainer>
          <BarChart
            data={config.data}
            margin={{ top: 24, right: 10, left: -10, bottom: longLabels ? 60 : 0 }}
            barCategoryGap="28%"
          >
            <CartesianGrid vertical={false} stroke="#EEEAF9" />
            <XAxis
              dataKey="name"
              tick={{ fontSize: longLabels ? 9.5 : 10.5, fill: "#9691AC" }}
              axisLine={{ stroke: "#EEEAF9" }}
              tickLine={false}
              interval={0}
              angle={longLabels ? -35 : 0}
              textAnchor={longLabels ? "end" : "middle"}
              height={longLabels ? 70 : 30}
            />
            <YAxis tick={{ fontSize: 11, fill: "#9691AC" }} axisLine={false} tickLine={false} width={32} />
            <Bar dataKey="value" radius={[8, 8, 0, 0]} maxBarSize={54}>
              {config.data.map((d, i) => (
                <Cell key={i} fill={d.color} />
              ))}
              <LabelList
                dataKey="value"
                position="top"
                formatter={(v) => `₹${v < 1 ? v.toFixed(4) : v}T`}
                style={{ fontSize: 11.5, fontWeight: 800, fill: "#1E1B3A" }}
              />
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </Box>
    </Paper>
  );
}

/* ---------------------------------------------------------------------- */
/*  Header                                                                  */
/* ---------------------------------------------------------------------- */

function DashboardHeader({ config }) {
  const [fy, setFy] = useState(config.financialYear);

  return (
    <Box
      sx={{
        position: "relative",
        mb: 2.5,
        px: { xs: 0.5, md: 1 },
        py: { xs: 2, md: 2.5 },
        // no background here — the app's own bg.svg (set globally, e.g. on <body>)
        // shows straight through behind the header text and controls.
      }}
    >
      <Stack
        direction={{ xs: "column", lg: "row" }}
        alignItems={{ xs: "flex-start", lg: "center" }}
        justifyContent="space-between"
        spacing={2}
      >
        <Box>
          <Typography sx={{ fontSize: { xs: 22, md: 26 }, fontWeight: 800, color: "#1E1B3A" }}>
            {config.title}
          </Typography>
          <Typography sx={{ fontSize: 13.5, color: "text.secondary", mt: 0.25 }}>
            {config.subtitle}
          </Typography>
        </Box>

        <Stack direction={{ xs: "column", sm: "row" }} spacing={1.5} alignItems="center" flexWrap="wrap">
          <Stack direction="row" spacing={1} alignItems="center">
            <Typography sx={{ fontSize: 13, color: "text.secondary", fontWeight: 600, whiteSpace: "nowrap" }}>
              Financial Year
            </Typography>
            <MiniSelect options={config.financialYearOptions} value={fy} onChange={setFy} />
          </Stack>

          <Chip
            icon={<CalendarTodayRoundedIcon sx={{ fontSize: "16px !important" }} />}
            label={`${config.dateRange.start}  ~  ${config.dateRange.end}`}
            sx={{
              bgcolor: "#fff",
              border: "1px solid #E7E2F7",
              fontWeight: 600,
              fontSize: 12.5,
              px: 0.5,
              height: 36,
              borderRadius: "10px",
            }}
          />

          <Button
            variant="contained"
            startIcon={<RefreshRoundedIcon />}
            sx={{
              textTransform: "none",
              fontWeight: 700,
              fontSize: 13.5,
              borderRadius: "10px",
              boxShadow: "none",
              px: 2,
              height: 36,
              "&:hover": { boxShadow: "none" },
            }}
          >
            Reset
          </Button>
        </Stack>
      </Stack>
    </Box>
  );
}

/* ---------------------------------------------------------------------- */
/*  Root Dashboard                                                         */
/* ---------------------------------------------------------------------- */

export default function Dashboard({ data = dashboardData }) {
  return (
    <ThemeProvider theme={theme}>
      <Box sx={{ bgcolor: "background.default", minHeight: "100vh", p: { xs: 1.5, md: 3 } }}>
        <DashboardHeader config={data.header} />

        {/* ==================== DEPOSITS ==================== */}
        <SectionTitle>Deposits</SectionTitle>

        <Box
          sx={{
            display: "grid",
            gridTemplateColumns: { xs: "1fr", lg: "1fr 1.6fr" },
            gap: 2.5,
            mb: 2.5,
            alignItems: "stretch",
          }}
        >
          <Gauge config={data.casaGauge} />
          <CompositionMosaic config={data.depositsComposition} icon={Inventory2RoundedIcon} />
        </Box>

        <Box
          sx={{
            display: "grid",
            gridTemplateColumns: { xs: "1fr", lg: "1fr 1fr" },
            gap: 2.5,
            mb: { xs: 3, lg: 4.5 },
            alignItems: "stretch",
          }}
        >
          <BarPanel icon={AccountBalanceWalletRoundedIcon} config={data.demandDeposits} />
          <BarPanel icon={DescriptionRoundedIcon} config={data.termDeposits} />
        </Box>

        {/* ==================== LOANS ==================== */}
        <SectionTitle>Loans</SectionTitle>

        <Box
          sx={{
            display: "grid",
            gridTemplateColumns: { xs: "1fr", lg: "1.2fr 1fr" },
            gap: 2.5,
            alignItems: "stretch",
          }}
        >
          <CompositionMosaic config={data.loansComposition} icon={AccountBalanceRoundedIcon} />
          <BarPanel icon={EqualizerRoundedIcon} config={data.loansBreakdown} />
        </Box>
      </Box>
    </ThemeProvider>
  );
}

