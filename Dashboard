/* ---------------------------------------------------------------------- */
/*  Theme-derived color helpers                                            */
/*  The JSON no longer carries any color values — every color used by a    */
/*  chart, tile, or dot below is pulled live from the MUI theme so the     */
/*  dashboard automatically re-skins with the theme (light/dark, brand     */
/*  palette changes, etc). Nothing here is a hardcoded hex.                */
/* ---------------------------------------------------------------------- */

/** A fixed-order list of theme tokens used as a categorical palette.
 * Cycling through semantic + tonal variants keeps neighbouring categories
 * visually distinct without ever introducing a color outside the theme. */
function categoricalPalette(theme) {
  const p = theme.palette;
  return [
    p.success.main,
    p.primary.main,
    p.error.main,
    p.info.main,
    p.success.dark,
    p.secondary.main,
    p.primary.dark,
    p.warning.main,
    p.secondary.dark,
    p.info.dark,
    p.error.dark,
    p.primary.light,
    p.success.light,
    p.warning.dark,
    p.info.light,
    p.secondary.light,
  ].filter(Boolean);
}

/** Deterministically maps a category name to a theme color, so "Term
 * Deposit" always renders the same color in the mosaic, the bar charts,
 * and every drill-down — without needing a lookup table to maintain. */
function colorForLabel(name, theme) {
  const palette = categoricalPalette(theme);
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = (hash * 31 + name.charCodeAt(i)) >>> 0;
  }
  return palette[hash % palette.length];
}

