/**
 * theme.js — plain design-token primitives.
 *
 * This replaces the old MUI `createTheme()` + `<ThemeProvider>` pair.
 * There is no theme *context* anymore: components import `theme` directly
 * and read the values they need out of it. This is the "existing theme
 * primitive file" the dashboard now pulls from — if your project already
 * has one, point the imports in Dashboard.jsx at it instead, as long as it
 * exposes the same shape (colors / radius / glass / typography).
 */

export const theme = {
  colors: {
    primary: "#6C5CE0",
    primaryDark: "#5847C9",
    primaryLight: "#8B7CF6",
    textPrimary: "#1E1B3A",
    textSecondary: "#6B6584",
    onPrimary: "#FFFFFF",
  },

  radius: {
    card: "20px",
    tile: "14px",
    control: "10px",
    pill: "999px",
  },

  // Glassmorphism tokens — every card/panel/control pulls from here so the
  // whole UI can be re-skinned by editing this one block.
  glass: {
    background: "rgba(255, 255, 255, 0.55)",
    backgroundStrong: "rgba(255, 255, 255, 0.72)",
    backgroundSubtle: "rgba(255, 255, 255, 0.4)",
    border: "1px solid rgba(255, 255, 255, 0.6)",
    borderSubtle: "1px solid rgba(255, 255, 255, 0.35)",
    blur: "blur(20px) saturate(180%)",
    blurSoft: "blur(12px) saturate(160%)",
    shadow: "0 8px 32px rgba(31, 38, 135, 0.12)",
    shadowHover: "0 12px 40px rgba(31, 38, 135, 0.18)",
    innerHairline: "inset 0 1px 0 rgba(255, 255, 255, 0.5)",
