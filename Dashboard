  const totalDeposits = useMemo(
    () => data.depositsComposition.items.reduce((sum, i) => sum + i.value, 0),
    [data]
  );
  const totalLoans = useMemo(
    () => data.loansComposition.items.reduce((sum, i) => sum + i.value, 0),
    [data]
  );
  const totalPortfolio = totalDeposits + totalLoans;

  const stats = [
    {
      icon: AccountBalanceRoundedIcon,
      label: "Total Deposits",
      value: `₹ ${totalDeposits.toFixed(2)} T`,
      caption: `${data.depositsComposition.items.length} categories`,
      accent: theme.palette.success.main,
    },
    {
      icon: AccountBalanceWalletRoundedIcon,
      label: "Total Loans",
      value: `₹ ${totalLoans.toFixed(2)} T`,
      caption: `${data.loansComposition.items.length} categories`,
      accent: theme.palette.primary.main,
    },
    {
      icon: PieChartRoundedIcon,
      label: "CASA Ratio",
      value: `${data.casaGauge.value.toFixed(1)}%`,
      caption: "Current + savings mix",
      accent: theme.palette.secondary.dark,
    },
    {
      icon: EqualizerRoundedIcon,
      label: "Total Portfolio",
      value: `₹ ${totalPortfolio.toFixed(2)} T`,
      caption: "Deposits + Loans",
      accent: theme.palette.info.main,
    },
  ];

  return (
    <Box
      sx={{
        display: "grid",
        gridTemplateColumns: { xs: "1fr 1fr", md: "repeat(4, 1fr)" },
        gap: 2,
      }}
    >
      {stats.map((s) => (
        <StatCard key={s.label} {...s} />
      ))}
    </Box>
  );
}

