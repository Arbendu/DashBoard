/* ---------------------------------------------------------------------- */
/*  Loading.jsx — reusable Circular Dot (orbiting dots) loading spinner.    */
/*                                                                        */
/*  - Pure CSS animation (transform + opacity only) → runs on the GPU       */
/*    compositor, no JS timers, no re-renders while spinning.              */
/*  - Everything is sized in percentages of the container, so the whole    */
/*    spinner scales perfectly from a single `size` prop (number = px, or  */
/*    any CSS length such as "clamp(48px, 8vw, 88px)").                    */
/*  - Honors `prefers-reduced-motion` (slows down instead of removing the  */
/*    cue, so users still see that something is loading).                  */
/*  - Accessible: role="status" + aria-live + aria-label.                  */
/*  - No new dependencies — MUI only, same as the rest of the project.     */
/*                                                                        */
/*  Usage:                                                                */
/*    <Loading />                                                         */
/*    <Loading label="Loading dashboard…" />                              */
/*    <Loading size={40} inline />          // no centering wrapper       */
/*    <Loading size="clamp(48px, 8vw, 88px)" minHeight="40vh" />          */
/* ---------------------------------------------------------------------- */

import React, { memo } from "react";
import { Box, Typography } from "@mui/material";
import { keyframes } from "@mui/material/styles";

/* ---- Animations --------------------------------------------------------- */

const orbit = keyframes`
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
`;

// Each dot breathes between 55% and 100% scale while fading slightly, which
// (combined with the staggered delays below) gives the "comet tail" feel.
const breathe = keyframes`
  0%, 100% { transform: scale(0.55); opacity: 0.55; }
  50%      { transform: scale(1);    opacity: 1;    }
`;

/* ---- Dot configuration ---------------------------------------------------
   `d` = dot diameter as a % of the spinner size. Varying sizes + a warm
   orange → coral → pink → magenta palette, matching the reference design. */

const ORBIT_RADIUS = 36; // % of spinner size (dot centres sit on this circle)
const ORBIT_DURATION_S = 2.4;
const PULSE_DURATION_S = 1.6;

const DOTS = [
  { color: "#FFAE2E", d: 13 }, // amber
  { color: "#FFA52E", d: 15 }, // amber
  { color: "#FF9A5C", d: 12 }, // orange
  { color: "#FF8A80", d: 14 }, // coral
  { color: "#FF86AE", d: 11 }, // rose
  { color: "#FF7EB6", d: 13 }, // pink
  { color: "#FF6EE0", d: 16 }, // magenta
  { color: "#FF78C8", d: 12 }, // hot pink
];

/* ---- Component ---------------------------------------------------------- */

function Loading({
  size = 64,
  label,
  inline = false,
  minHeight = "60vh",
  gap = 2,
  labelSx,
  sx,
}) {
  const spinner = (
    <Box
      role="status"
      aria-live="polite"
      aria-label={label || "Loading"}
      sx={{
        position: "relative",
        width: size,
        height: size,
        flexShrink: 0,
        contain: "layout paint size", // isolate repaints from the page
      }}
    >
      <Box
        aria-hidden="true"
        sx={{
          position: "absolute",
          inset: 0,
          willChange: "transform",
          animation: `${orbit} ${ORBIT_DURATION_S}s linear infinite`,
          "@media (prefers-reduced-motion: reduce)": {
            animationDuration: `${ORBIT_DURATION_S * 3}s`,
          },
        }}
      >
        {DOTS.map(({ color, d }, i) => (
          // Wrapper is rotated into position; the inner dot only animates
          // scale/opacity, so the two transforms never fight each other.
          <Box
            key={i}
            sx={{
              position: "absolute",
              inset: 0,
              transform: `rotate(${(360 / DOTS.length) * i}deg)`,
            }}
          >
            <Box
              sx={{
                position: "absolute",
                top: `${50 - ORBIT_RADIUS - d / 2}%`,
                left: `${50 - d / 2}%`,
                width: `${d}%`,
                aspectRatio: "1 / 1",
                borderRadius: "50%",
                backgroundColor: color,
                willChange: "transform, opacity",
                animation: `${breathe} ${PULSE_DURATION_S}s ease-in-out infinite`,
                animationDelay: `${-(PULSE_DURATION_S / DOTS.length) * i}s`,
                "@media (prefers-reduced-motion: reduce)": {
                  animation: "none",
                },
              }}
            />
          </Box>
        ))}
      </Box>
    </Box>
  );

  if (inline && !label) return spinner;

  return (
    <Box
      sx={{
        display: inline ? "inline-flex" : "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        gap,
        ...(inline ? null : { minHeight, width: "100%" }),
        ...sx,
      }}
    >
      {spinner}
      {label && (
        <Typography
          variant="body2"
          color="text.secondary"
          sx={{ letterSpacing: 0.2, ...labelSx }}
        >
          {label}
        </Typography>
      )}
    </Box>
  );
}

export default memo(Loading);

















/* ---------------------------------------------------------------------- */
/*  DashboardPage.jsx — main entry point / the ONE place the real API      */
/*  gets wired in.                                                        */
/*  Uses the project's existing `useApi` hook to fetch TWO independent      */
/*  endpoints once on mount:                                              */
/*   - /DS/dashboard/dashboard-data — the static snapshot (heatmap tiles,   */
/*     CASA ratio), mapped by mapApiToDashboardData.js.                    */
/*   - /DS/dashboard/trend-data — the 7-day date-wise data behind the       */
/*     Demand/Time Deposits and Loan Distribution panels, mapped by         */
/*     trendApi.js's mapTrendDataToSections().                            */
/*  Each fetch has its own independent loading/error state (two separate   */
/*  useApi() instances — sharing one would mix up their results), but the  */
/*  page waits for BOTH before rendering the dashboard, and surfaces        */
/*  either one's error the same way — this keeps the existing loading/     */
/*  error UI and overall page behavior unchanged, just gated on two        */
/*  fetches instead of one.                                               */
/*  No component under DepositsLoansDashboard knows an API exists — this   */
/*  is the only file that needs to change if either endpoint, auth, or      */
/*  response shape changes. Mount this file directly as your route/page.   */
/* ---------------------------------------------------------------------- */

import React, { useEffect, useMemo } from "react";
import { Box, Button, Typography } from "@mui/material";
import useApi from "../../hooks/useApi"; // adjust path to match your project structure
import DepositsLoansDashboard from "./DepositsLoansDashboard";
import Loading from "./Loading";
import mapApiToDashboardData from "./MapApiToDashboardData";
import { mapTrendDataToSections, TREND_DATA_ENDPOINT } from "./trendApi";
import { textSecondarySx } from "./Common";

const DASHBOARD_ENDPOINT = "/DS/dashboard/dashboard-data";

export default function DashboardPage() {
  const { data: apiResponse, error, loading, callApi } = useApi();
  const {
    data: trendResponse,
    error: trendError,
    loading: trendLoading,
    callApi: callTrendApi,
  } = useApi();

  useEffect(() => {
    // Both fetches fire in parallel — neither waits on the other, since
    // they're two independent endpoints feeding two independent parts of
    // the page.
    callApi(DASHBOARD_ENDPOINT).catch(() => {
      // Swallow here — `error` from useApi already captures it below, and
      // callApi's own catch already logs the underlying error.
    });
    callTrendApi(TREND_DATA_ENDPOINT).catch(() => {
      // Same as above, for the trend fetch.
    });
    // Only fetch once on mount.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // The actual dashboard content is nested one level in:
  // response.data.staticDashboardData[0]. mapApiToDashboardData does all
  // the shape translation + derived calculations (share %, topValue, ...).
  const dashboardData = useMemo(() => {
    const section = apiResponse?.data?.staticDashboardData?.YSA ?? apiResponse?.data?.staticDashboardData?.[0];
    return mapApiToDashboardData(section);
  }, [apiResponse]);

  // trend-data's envelope is simpler: response.data is directly the array
  // of { key, title, products, data } sections.
  const trendSections = useMemo(
    () => mapTrendDataToSections(trendResponse?.data),
    [trendResponse],
  );

  const isLoading = (loading || trendLoading) && !dashboardData;
  const hasError = error || trendError;

  if (isLoading) {
    return <Loading label="Loading dashboard…" labelSx={textSecondarySx} />;
  }

  if (hasError) {
    const failedMessage =
      error?.response?.data?.message ||
      error?.message ||
      trendError?.response?.data?.message ||
      trendError?.message ||
      "Something went wrong while fetching data.";
    return (
      <Box
        sx={{
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          justifyContent: "center",
          minHeight: "60vh",
          gap: 2,
          textAlign: "center",
          px: 3,
        }}
      >
        <Typography sx={{ fontWeight: 700 }}>
          Couldn't load the dashboard
        </Typography>
        <Typography sx={textSecondarySx}>{failedMessage}</Typography>
        <Button
          variant="contained"
          onClick={() => {
            callApi(DASHBOARD_ENDPOINT);
            callTrendApi(TREND_DATA_ENDPOINT);
          }}
        >
          Retry
        </Button>
      </Box>
    );
  }

  if (!dashboardData) {
    return (
      <Box
        sx={{
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          minHeight: "60vh",
        }}
      >
        <Typography sx={textSecondarySx}>
          No dashboard data available.
        </Typography>
      </Box>
    );
  }

  // No `fetchDrilldown` passed — there's currently no drill-down endpoint,
  // so every bar renders display-only until one exists (see BarPanel.jsx).
  return (
    <DepositsLoansDashboard
      data={dashboardData}
      trendSections={trendSections}
    />
  );
}












